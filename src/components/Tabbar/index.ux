<!--
  底部导航栏组件
  - 通过 props.activeTab 接收当前激活的 tab key
  - 点击时通过 $dispatch('tabchange', { key }) 通知父页面（MainPage）
  - 不再直接操作路由，由 MainPage 统一管理 tab 切换
  - 样式自包含

  用法（仅在 MainPage 中）：
    <import name="tab-bar" src="../../components/Tabbar/index.ux"></import>
    <tab-bar active-tab="{{ activeTab }}" ontabchange="onTabChange"></tab-bar>
-->
<template>
  <div class="tabbar">
    <!-- 陪伴 -->
    <div class="tab-item {{ activeTab === 'companion' ? 'tab-active' : '' }}" onclick="onTabClick('companion')">
      <text class="tab-icon">🏠</text>
      <text class="tab-label">陪伴</text>
    </div>
    <!-- 聊天 -->
    <div class="tab-item {{ activeTab === 'breakIce' ? 'tab-active' : '' }}" onclick="onTabClick('breakIce')">
      <text class="tab-icon">💬</text>
      <text class="tab-label">聊天</text>
    </div>
    <!-- 传承 -->
    <div class="tab-item {{ activeTab === 'memory' ? 'tab-active' : '' }}" onclick="onTabClick('memory')">
      <text class="tab-icon">📚</text>
      <text class="tab-label">传承</text>
    </div>
    <!-- 我的 -->
    <div class="tab-item {{ activeTab === 'profile' ? 'tab-active' : '' }}" onclick="onTabClick('profile')">
      <text class="tab-icon">👤</text>
      <text class="tab-label">我的</text>
    </div>
  </div>
</template>

<script>
/**
 * Tabbar 组件 —— 只负责 UI 展示 + 事件通知。
 * 不再直接操作路由；tab 切换由父页面（MainPage）通过 on-tabchange 事件处理。
 */
export default {
  props: ['activeTab'],

  onTabClick(key) {
    if (!key || key === this.activeTab) return
    // 向上层派发 tabchange 事件，由 MainPage 统一管理 tab 切换
    this.$dispatch('tabchange', { key })
  },
}
</script>

<style>
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 90px;
  background-color: #fff;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
  border-top: 1px solid #f0e8df;
}

.tab-item {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8px 20px;
}

.tab-icon {
  font-size: 36px;
}

.tab-label {
  font-size: 22px;
  color: #9a8b7a;
  margin-top: 4px;
}

.tab-active .tab-label {
  color: #d4874b;
}
</style>
