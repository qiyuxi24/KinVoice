{
  "package": "com.kinvoice.app",
  "name": "KinVoice",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1070,
  "icon": "/assets/images/logo.png",
  "features": [
    {
      "name": "system.prompt"
    },
    {
      "name": "system.router"
    },
    {
      "name": "system.shortcut"
    },
    {
      "name": "system.fetch"
    },
    {
      "name": "system.storage"
    }
  ],
  "permissions": [
    {
      "origin": "*"
    }
  ],
  "template/official": "demo-template",
  "config": {
    "logLevel": "debug"
  },
  "router": {
    "entry": "pages/Main",
    "pages": {
      "pages/Main": {
        "component": "index"
      },
      "pages/About": {
        "component": "index"
      },
      "pages/Demo": {
        "component": "index"
      },
      "pages/DemoDetail": {
        "component": "index"
      },
      "pages/BreakIce": {
        "component": "index"
      },
      "pages/Companion": {
        "component": "index"
      },
      "pages/Memory": {
        "component": "index"
      },
      "pages/Profile": {
        "component": "index"
      },
      "pages/ProfileDetail": {
        "component": "index"
      },
      "pages/Family": {
        "component": "index"
      },
      "pages/FamilyJoin": {
        "component": "index"
      },
      "pages/ChatRoom": {
        "component": "index"
      },
      "pages/Help": {
        "component": "index"
      },
      "pages/Settings": {
        "component": "index"
      },
      "pages/CustomVoice": {
        "component": "index"
      },
      "pages/VoiceSelect": {
        "component": "index"
      }
    },
    "widgets": {
      "CardDemo": {
        "name": "CardDemo",
        "description": "快应用卡片展示",
        "component": "index",
        "path": "/CardDemo",
        "minPlatformVersion": 1032,
        "targetManufactorys": [
          "vivo"
        ],
        "features": []
      }
    }
  },
  "display": {
    "titleBarBackgroundColor": "#f2f2f2",
    "titleBarTextColor": "#414141",
    "pages": {
      "pages/Main": {
        "titleBarText": ""
      },
      "pages/Demo": {
        "titleBarText": "快应用示例模版"
      },
      "pages/DemoDetail": {
        "titleBarText": "详情页"
      },
      "pages/BreakIce": {
        "titleBarText": "家庭聊天"
      },
      "pages/Companion": {
        "titleBarText": "AI 陪伴"
      },
      "pages/Memory": {
        "titleBarText": "传承页"
      },
      "pages/Profile": {
        "titleBarText": "我的"
      },
      "pages/ProfileDetail": {
        "titleBarText": "用户档案"
      },
      "pages/Family": {
        "titleBarText": "家庭组"
      },
      "pages/FamilyJoin": {
        "titleBarText": "加入家庭组"
      },
      "pages/ChatRoom": {
        "titleBarText": "聊天"
      },
      "pages/Help": {
        "titleBarText": "帮助与反馈"
      },
      "pages/Settings": {
        "titleBarText": "设置"
      },
      "pages/CustomVoice": {
        "titleBarText": "自定义音色"
      },
      "pages/VoiceSelect": {
        "titleBarText": "音色选择"
      }
    }
  }
}
