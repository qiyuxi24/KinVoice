function BridgeView() {
  const [rawText, setRawText] = useState('');
  const [translatedText, setTranslatedText] = useState('');
  const [isTranslating, setIsTranslating] = useState(false);
  const [copySuccess, setCopySuccess] = useState(false);

  const handleTranslate = async () => {
    if (!rawText.trim() || isTranslating) return;
    setIsTranslating(true);
    setTranslatedText(''); // 重新生成时先清空
    const systemPrompt = `你是一个“情感缓冲带”AI，精通心理学和非暴力沟通(NVC)。
用户会输入他们在生气或冲动时想对家人说的话。
你的任务是将这些带有攻击性的话语，翻译成【高情商、委婉、共情】的表达方式。直接输出翻译后的话术，不要解释。`;

    const response = await generateAIResponse(rawText, systemPrompt);
    setTranslatedText(response);
    setIsTranslating(false);
  };

  const handleCopy = async () => {
    try {
      await navigator.clipboard.writeText(translatedText);
      setCopySuccess(true);
    } catch (err) {
      // 兼容性方案
      const el = document.createElement('textarea');
      el.value = translatedText;
      document.body.appendChild(el);
      el.select();
      document.execCommand('copy');
      document.body.removeChild(el);
      setCopySuccess(true);
    }
    setTimeout(() => setCopySuccess(false), 2000); // 2秒后恢复按钮状态
  };

  return (
    <div className="min-h-full bg-[#faf3e8] text-[#1a1a2e] flex flex-col">
