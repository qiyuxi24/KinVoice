                <span className="text-sm text-[#8c746b] font-bold">项目名称</span>
                <span className="text-sm font-black text-[#6b4c41]">Cloudie (懂你信箱)</span>
              </div>
              <div>
                <span className="text-sm text-[#8c746b] block mb-2 px-1 font-bold">开发团队成员</span>
                <div className="flex flex-wrap gap-2">
                  {['佀佳超', '谭文星', '夏学森', '薛入翡', '王耀阳'].map(name => (
                    <span key={name} className="text-xs bg-white border border-[#e8d5c4] text-[#6b4c41] px-3 py-1.5 rounded-lg shadow-sm font-bold">{name}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      {showVoiceManager && (
        <div className="fixed inset-0 bg-[#6b4c41]/80 z-50 flex justify-center items-end sm:items-center p-0 sm:p-4 animate-fade-in backdrop-blur-md">
          <div className="bg-[#faf3e8] w-full max-w-md h-[85vh] sm:h-[600px] sm:rounded-[32px] rounded-t-[32px] flex flex-col shadow-2xl overflow-hidden relative animate-slide-up">
            
            <div className="p-5 text-center border-b border-[#e8d5c4] relative bg-white shrink-0">
              {cloneStep !== 0 && (
                 <button onClick={() => setCloneStep(0)} className="absolute left-4 top-6 text-[#91afb8] font-bold text-sm">取消</button>
              )}
              <h2 className="text-lg font-bold text-[#6b4c41]">
                {cloneStep === 0 ? "家庭声音库" : (cloneStep === 1 ? "声音录制" : "特征建档")}
              </h2>
              <button onClick={() => {setShowVoiceManager(false); setCloneStep(0);}} className="absolute right-4 top-6 text-[#8c746b]"><X size={20}/></button>
            </div>
            
            <div className="p-6 overflow-y-auto flex-1 flex flex-col">
              
              {cloneStep === 0 && (
                <>
                  <div className="flex justify-between items-center mb-6">
                     <p className="text-sm text-[#8c746b] font-medium">管理长辈语音特征，用于传承卡片播报。</p>
                  </div>

                  <div className="space-y-4 flex-1">
                    {voiceLibrary.map(voice => (
                      <div key={voice.id} className="bg-white p-5 rounded-2xl shadow-sm border border-[#e8d5c4]/50 flex justify-between items-center group relative overflow-hidden">
                        <div className="absolute left-0 top-0 w-1.5 h-full bg-[#91afb8]"></div>
                        <div>
                          <h4 className="font-bold text-[#6b4c41] text-lg mb-2">{voice.name}</h4>
                          <div className="flex gap-2">
                            {voice.tags.map(tag => (
                              <span key={tag} className="text-xs bg-[#eaf1f3] text-[#91afb8] px-2 py-1 rounded font-bold flex items-center gap-1">
                                <Tag size={10} /> {tag}
                              </span>
                            ))}
                          </div>
                        </div>
                        <button onClick={() => handleDeleteVoice(voice.id)} className="w-10 h-10 rounded-full bg-red-50 text-red-400 flex justify-center items-center hover:bg-red-100 transition-colors">
                          <Trash2 size={16} />
                        </button>
                      </div>
                    ))}
                  </div>

                  <button onClick={() => setCloneStep(1)} className="w-full bg-[#91afb8] text-white py-4 rounded-2xl font-bold mt-6 shadow-lg flex items-center justify-center gap-2 hover:bg-[#7a9ba4]">
                    <PlusCircle size={18} /> 新建录入 / 克隆音色
                  </button>
                </>
              )}

              {cloneStep === 1 && (
                <div className="flex-1 flex flex-col items-center justify-center">
                  <div className="relative w-32 h-32 flex items-center justify-center mb-8">
                    <div className="absolute inset-0 bg-[#91afb8]/30 rounded-full animate-ping"></div>
                    <div className="w-24 h-24 bg-[#91afb8] rounded-full flex items-center justify-center relative z-10 text-white shadow-xl shadow-[#91afb8]/40">
                      <Mic size={40} />
                    </div>
                  </div>
                  <h3 className="font-bold text-lg text-[#6b4c41] mb-3">AI 正在收听长辈说话</h3>
                  <p className="text-sm text-[#8c746b] font-medium bg-white p-5 rounded-2xl text-center border border-[#e8d5c4] shadow-sm w-full leading-relaxed">
                    “落霞与孤鹜齐飞，秋水共长天一色...”<br/>
                    <span className="text-xs text-[#91afb8] mt-3 block font-bold">(请持续说话 10 秒以上提取特征)</span>
                  </p>
                  <button onClick={handleStartRecord} className="mt-10 px-8 py-3.5 bg-[#6b4c41] text-white rounded-full font-bold shadow-md hover:bg-[#5a3f36] transition-colors">
                    模拟录音完成
                  </button>
                </div>
              )}

              {cloneStep === 2 && (
                <div className="flex-1 flex flex-col">
                  <div className="bg-[#eaf1f3] text-[#7a9ba4] p-5 rounded-2xl flex items-center gap-4 mb-8 border border-[#91afb8]/30">
                    <CheckCircle2 size={28} className="text-[#91afb8]" />
                    <div>
                      <p className="font-bold text-base text-[#6b4c41]">特征提取成功！</p>
                      <p className="text-xs font-medium mt-1">请为该声音添加身份标识与属性标签。</p>
                    </div>
                  </div>

                  <div className="space-y-6">
                    <div>
                      <label className="block text-sm font-bold text-[#6b4c41] mb-2">这段声音是谁的？(如: 爷爷)</label>
                      <input 
                        type="text" 
                        value={newName}
                        onChange={(e) => setNewName(e.target.value)}
                        placeholder="输入长辈称呼" 
                        className="w-full bg-white border border-[#e8d5c4] rounded-xl p-4 outline-none focus:border-[#91afb8] focus:ring-1 focus:ring-[#91afb8] font-bold text-[#6b4c41] shadow-inner"
                      />
                    </div>

                    <div>
                      <label className="block text-sm font-bold text-[#6b4c41] mb-3">选择声音特征标签 (最多3个)</label>
                      <div className="flex flex-wrap gap-3">
                        {availableTags.map(tag => (
                          <button
                            key={tag}
                            onClick={() => toggleTag(tag)}
                            className={`px-4 py-2 rounded-full text-sm font-bold transition-all border ${
                              selectedTags.includes(tag) 
                                ? 'bg-[#91afb8] text-white border-[#91afb8] shadow-md' 
                                : 'bg-white text-[#8c746b] border-[#e8d5c4] hover:border-[#91afb8]'
                            }`}
                          >
                            {tag}
                          </button>
                        ))}
                      </div>
                    </div>
                  </div>

                  <button 
                    onClick={handleSaveVoice}
                    disabled={!newName}
                    className="w-full bg-[#6b4c41] text-white py-4 rounded-2xl font-bold mt-auto shadow-lg disabled:opacity-50 flex items-center justify-center gap-2 hover:bg-[#5a3f36]"
                  >
                    <Save size={18} /> 保存并入库
                  </button>
                </div>
              )}

            </div>
          </div>
        </div>
      )}
    </div>
  );
}

function MenuItem({ icon, title, subtitle }) {
  return (
    <div className="flex items-center justify-between p-4 hover:bg-[#faf3e8]/50 rounded-2xl cursor-pointer transition-colors group">
      <div className="flex items-center gap-4">
        <div className="p-2.5 bg-[#faf3e8] rounded-xl group-hover:bg-white transition-colors border border-transparent group-hover:border-[#e8d5c4]/50">{icon}</div>
        <div>
          <h4 className="text-[#6b4c41] font-bold text-sm">{title}</h4>
          {subtitle && <p className="text-xs text-[#8c746b] font-medium mt-1">{subtitle}</p>}
        </div>
      </div>
      <ChevronRight size={16} className="text-[#a8c4c9]" />
    </div>
  );
}

