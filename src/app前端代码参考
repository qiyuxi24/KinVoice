              {translatedText}
            </p>
            
            {/* 核心改动：新增发送与重试操作组 */}
            <div className="mt-5 flex gap-3">
              <button 
                onClick={handleCopy}
                className="flex-1 bg-[#91afb8] hover:bg-[#7a9ba4] text-white py-3 rounded-xl text-sm font-bold transition-all shadow-sm flex items-center justify-center gap-2"
              >
                {copySuccess ? <CheckCircle2 size={16} /> : <Copy size={16} />}
                {copySuccess ? '已复制！快去粘贴发送吧' : '一键发送给家人 (复制)'}
              </button>
              <button 
                onClick={handleTranslate}
                disabled={isTranslating}
                className="flex-[0.4] bg-white border border-[#e8d5c4] text-[#6b4c41] hover:bg-gray-50 py-3 rounded-xl text-sm font-bold transition-all shadow-sm flex items-center justify-center gap-1 disabled:opacity-50"
              >
                <RefreshCw size={16} className={isTranslating ? "animate-spin" : ""} />
                重新生成
              </button>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}

