            className="w-full bg-red-50/50 rounded-xl p-4 text-sm outline-none resize-none h-28 focus:ring-1 focus:ring-red-200 text-gray-800"
            placeholder="例如：你们从来都不理解我！总是把你们的想法强加给我！"
            value={rawText}
            onChange={(e) => setRawText(e.target.value)}
