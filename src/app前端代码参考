        </div>

        {translatedText && (
          <div className="bg-white rounded-3xl p-5 shadow-sm border border-[#c4c4c4]/20 relative overflow-hidden animate-fade-in-up">
            <div className="absolute top-0 left-0 w-1.5 h-full bg-[#91afb8]"></div>
