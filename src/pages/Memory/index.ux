<template>
  <div class="page">
    <div class="header">
      <text class="page-title">📚 家庭记忆库</text>
      <text class="page-subtitle">代代相传的专属回忆与智慧 💕</text>
    </div>

    <div class="category-tabs">
      <div 
        class="tab tab-first {{ activeCategory === '人生阅历' ? 'tab-active' : '' }}" 
        onclick="switchCategory('人生阅历')" 
      >
        <text>👤 人生阅历</text>
      </div>
      <div 
        class="tab {{ activeCategory === '家庭菜谱' ? 'tab-active' : '' }}" 
        onclick="switchCategory('家庭菜谱')" 
      >
        <text>🍳 家庭菜谱</text>
      </div>
      <div 
        class="tab {{ activeCategory === '成长故事' ? 'tab-active' : '' }}" 
        onclick="switchCategory('成长故事')" 
      >
        <text>🌱 成长故事</text>
      </div>
      <div 
        class="tab {{ activeCategory === '相处感悟' ? 'tab-active' : '' }}" 
        onclick="switchCategory('相处感悟')" 
      >
        <text>💭 相处感悟</text>
      </div>
    </div>

    <div class="section-header">
      <text class="section-title">[{{ activeCategory }}] 相关记录 ✨</text>
      <div class="add-btn" onclick="showModal">
        <text class="add-icon">+</text>
        <text class="add-text">录入新经验</text>
      </div>
    </div>

    <div class="content-scroll">
      <div class="card-list">
        <div class="memory-card" for="item in currentCards">
          <div class="card-left">
            <div class="card-tag">
              <text class="tag-text">#{{ item.tag }}</text>
            </div>
            <text class="card-date">{{ item.date }}</text>
          </div>
          <div class="card-center">
            <text class="card-title">{{ item.title }}</text>
          </div>
          <div class="card-right">
            <div class="card-author">
              <text class="author-icon">👤</text>
              <text class="author-text">来自 {{ item.author }}</text>
            </div>
            <text class="card-content">{{ item.content }}</text>
          </div>
        </div>
      </div>
    </div>

    <div class="tabbar">
      <div class="tab-item" onclick="goCompanion">
        <text class="tab-icon">🏠</text>
        <text class="tab-label">陪伴</text>
      </div>
      <div class="tab-item" onclick="goBreakIce">
        <text class="tab-icon">💬</text>
        <text class="tab-label">破冰</text>
      </div>
      <div class="tab-item tab-active">
        <text class="tab-icon">📚</text>
        <text class="tab-label">传承</text>
      </div>
      <div class="tab-item" onclick="goProfile">
        <text class="tab-icon">👤</text>
        <text class="tab-label">我的</text>
      </div>
    </div>

    <div class="modal-overlay" if="showModalFlag">
      <div class="modal-content">
        <div class="modal-header">
          <text class="modal-title">📝 录入新经验</text>
          <div class="modal-close" onclick="hideModal">
            <text>×</text>
          </div>
        </div>
        
        <div class="modal-body">
          <text class="form-label">🏷️ 所属分类</text>
          <div class="category-options">
            <div 
              class="category-option option-first {{ formData.category === '人生阅历' ? 'option-active' : '' }}" 
              onclick="selectCategory('人生阅历')" 
            >
              <text>👤 人生阅历</text>
            </div>
            <div 
              class="category-option {{ formData.category === '家庭菜谱' ? 'option-active' : '' }}" 
              onclick="selectCategory('家庭菜谱')" 
            >
              <text>🍳 家庭菜谱</text>
            </div>
            <div 
              class="category-option {{ formData.category === '成长故事' ? 'option-active' : '' }}" 
              onclick="selectCategory('成长故事')" 
            >
              <text>🌱 成长故事</text>
            </div>
            <div 
              class="category-option {{ formData.category === '相处感悟' ? 'option-active' : '' }}" 
              onclick="selectCategory('相处感悟')" 
            >
              <text>💭 相处感悟</text>
            </div>
          </div>

          <text class="form-label">📛 卡片标题</text>
          <input class="form-input" type="text" placeholder="给这段记忆起个名字" onchange="onTitleChange" />

          <text class="form-label">📝 正文内容</text>
          <textarea class="form-textarea" placeholder="记录下你的故事、经验或感悟..." onchange="onContentChange"></textarea>
        </div>

        <div class="modal-submit" onclick="saveCard">
          <text>✅ 保存留存</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'

export default {
  private: {
    activeCategory: '人生阅历',
    showModalFlag: false,
    formData: {
      category: '人生阅历',
      title: '',
      content: ''
    },
    cards: {
      '人生阅历': [
        {
          tag: '人生阅历',
          date: '2023.10.15',
          title: '关于工作与选择',
          author: '爸爸',
          content: '刚工作时别怕吃亏，所有的经历都是财富。当年我第一次去深圳的时候，兜里只有几百块钱。找工作碰壁了无数次，但每一次失败都让我更清楚自己想要什么。'
        },
        {
          tag: '人生阅历',
          date: '2022.05.12',
          title: '买房子的学问',
          author: '爷爷',
          content: '买房地段永远是第一位的。当年我们单位分房，很多人图大选了郊区，我选了市中心的小破房。事实证明，便利性比面积更重要。'
        },
        {
          tag: '人生阅历',
          date: '2024.01.05',
          title: '面对失败的勇气',
          author: '妈妈',
          content: '你考研失利那段时间，总把自己关在房间里。我想告诉你，失败并不可怕，重要的是要有重新站起来的勇气。'
        }
      ],
      '家庭菜谱': [
        {
          tag: '家庭菜谱',
          date: '2024.01.02',
          title: '祖传红烧肉秘方',
          author: '妈妈',
          content: '咱们家的红烧肉，关键在于炒糖色。一定不能用老抽上色！锅里放少许油，放入冰糖小火慢熬，起密集小泡后倒入肉块翻炒。'
        },
        {
          tag: '家庭菜谱',
          date: '2023.12.20',
          title: '冬日驱寒羊肉汤',
          author: '奶奶',
          content: '羊肉去膻味，不用大料，只需要放几片白萝卜一起煮。煮出来的萝卜捞出扔掉，汤就会变得清甜无比。'
        },
        {
          tag: '家庭菜谱',
          date: '2024.03.11',
          title: '秘制糖醋排骨',
          author: '爸爸',
          content: '记住口诀：一酒二酱三糖四醋。料酒一勺，生抽两勺，白糖三勺，陈醋四勺，这样调出来的味道最正宗。'
        }
      ],
      '成长故事': [
        {
          tag: '成长故事',
          date: '2023.06.15',
          title: '第一次独自旅行',
          author: '姐姐',
          content: '18岁那年，我一个人去了云南。在大理的客栈里，我遇到了很多有趣的人，学会了独立和坚强。那是我人生中最宝贵的经历。'
        },
        {
          tag: '成长故事',
          date: '2022.09.01',
          title: '学会骑自行车',
          author: '爸爸',
          content: '你小时候学骑车，摔了很多次都不哭。这种坚持的精神，爸爸很为你骄傲。记住，遇到困难不要轻易放弃。'
        }
      ],
      '相处感悟': [
        {
          tag: '相处感悟',
          date: '2024.02.14',
          title: '沟通的艺术',
          author: '妈妈',
          content: '和家人相处，最重要的是倾听。有时候，不需要急着给出建议，安静地听对方说完，就是最好的陪伴。'
        },
        {
          tag: '相处感悟',
          date: '2023.11.20',
          title: '换位思考',
          author: '爷爷',
          content: '年纪大了才明白，每个人都有自己的难处。多站在对方的角度想想，很多矛盾就化解了。'
        }
      ]
    }
  },

  onInit() {
    this.$page.setTitleBar({ text: '' })
    this.loadCards()
  },

  onShow() {
    this.loadCards()
  },

  loadCards() {
    storage.get({
      key: 'memory_cards',
      success: (data) => {
        if (data) {
          try {
            const savedCards = JSON.parse(data)
            Object.keys(savedCards).forEach(key => {
              if (this.cards[key]) {
                this.cards[key] = [...savedCards[key]]
              }
            })
          } catch (e) {
            console.log('Failed to parse saved cards')
          }
        }
      },
      fail: () => {
        console.log('No saved cards found')
      }
    })
  },

  saveCards() {
    storage.set({
      key: 'memory_cards',
      value: JSON.stringify(this.cards),
      success: () => {
        console.log('Cards saved successfully')
      },
      fail: () => {
        console.log('Failed to save cards')
      }
    })
  },

  computed: {
    currentCards() {
      return this.cards[this.activeCategory] || []
    }
  },

  switchCategory(category) {
    this.activeCategory = category
  },

  selectCategory(category) {
    this.formData.category = category
  },

  showModal() {
    this.showModalFlag = true
  },

  hideModal() {
    this.showModalFlag = false
  },

  onTitleChange(event) {
    this.formData.title = event.value || ''
  },

  onContentChange(event) {
    this.formData.content = event.text || ''
  },

  saveCard() {
    if (!this.formData.title || !this.formData.content) {
      $utils.showToast('请填写完整信息')
      return
    }

    const newCard = {
      tag: this.formData.category,
      date: new Date().toLocaleDateString('zh-CN').replace(/\//g, '.'),
      title: this.formData.title,
      author: '我',
      content: this.formData.content
    }

    this.cards[this.formData.category].unshift(newCard)
    this.saveCards()
    this.hideModal()
    this.formData = {
      category: '人生阅历',
      title: '',
      content: ''
    }
    $utils.showToast('✅ 保存成功')
  },

  goCompanion() {
    router.replace({ uri: '/pages/Companion' })
  },

  goBreakIce() {
    router.replace({ uri: '/pages/BreakIce' })
  },

  goMemory() {
    router.replace({ uri: '/pages/Memory' })
  },

  goProfile() {
    router.replace({ uri: '/pages/Profile' })
  }
}
</script>

