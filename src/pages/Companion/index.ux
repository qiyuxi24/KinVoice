<import src="../../components/ContextMenu/index.ux" name="context-menu"></import>
<template>
  <div class="page">
    <!-- 侧边栏遮罩 -->
    <div class="sidebar-overlay" if="showSidebar" onclick="closeSidebar"></div>

    <!-- 侧边栏 -->
    <div class="sidebar {{ showSidebar ? 'sidebar-open' : '' }}">
      <div class="sidebar-header">
        <text class="sidebar-title">对话记录</text>
        <div class="sidebar-new-btn" onclick="newConversation">
          <text class="sidebar-new-icon">+</text>
        </div>
      </div>
      <div class="sidebar-list">
        <block for="conv in conversationList">
          <div class="sidebar-item {{ conv.id === conversationId ? 'sidebar-item-active' : '' }}"
               onclick="switchConversation(conv.id)">
            <div class="sidebar-item-main">
              <text class="sidebar-item-title">{{ conv.title || '新对话' }}</text>
              <text class="sidebar-item-date">{{ conv.created_at }}</text>
            </div>
            <div class="sidebar-item-del" onclick="deleteConversation(conv.id, $event)">
              <text class="sidebar-del-icon">×</text>
            </div>
          </div>
        </block>
        <div class="sidebar-empty" if="conversationList.length === 0">
          <text class="sidebar-empty-text">暂无对话记录</text>
        </div>
      </div>
    </div>

    <!-- 主聊天区 -->
    <div class="main-area">
      <div class="title-bar">
        <div class="hamburger" onclick="toggleSidebar">
          <text class="hamburger-line"></text>
          <text class="hamburger-line"></text>
          <text class="hamburger-line"></text>
        </div>
        <text class="title-text">Cloudie</text>
        <text class="title-sub">你的家庭情绪树洞</text>
      </div>

      <!-- 对话消息列表（双击弹出菜单） -->
      <div class="chat-list" id="chatList">
        <block for="(index, msg) in messages">
          <div class="msg-row msg-ai" if="msg.role === 'assistant'" onclick="handleMessageClick(index, $event)">
            <image class="msg-avatar" src="../../assets/images/logo.png" />
            <div class="msg-body">
              <div class="msg-bubble msg-bubble-ai">
                <text class="msg-text">{{ msg.content }}</text>
              </div>
            </div>
          </div>
          <div class="msg-row msg-user" elif="msg.role === 'user'" onclick="handleMessageClick(index, $event)">
            <div class="msg-body">
              <div class="msg-bubble msg-bubble-user">
                <text class="msg-text">{{ msg.content }}</text>
              </div>
            </div>
            <div class="msg-avatar msg-avatar-user">
              <text class="avatar-placeholder">我</text>
            </div>
          </div>
          <div class="msg-row msg-system" else>
            <text class="msg-system-text">{{ msg.content }}</text>
          </div>
        </block>

        <div class="msg-row msg-ai" if="isThinking">
          <image class="msg-avatar" src="../../assets/images/logo.png" />
          <div class="msg-body">
            <div class="msg-bubble msg-bubble-ai msg-bubble-thinking">
              <text class="msg-text msg-thinking">···</text>
            </div>
          </div>
        </div>
        <div class="chat-bottom-spacer"></div>
      </div>

      <div class="bottom-input-area">
        <input class="message-input" type="text" placeholder="告诉小云你的心事吧..." value="{{ messageText }}" onchange="onMessageChange" />
        <div class="send-btn" onclick="sendMessage">
          <text class="send-icon">→</text>
        </div>
      </div>
    </div>

    <!-- 内联菜单（播放/删除） -->
    <div class="context-menu-bg" if="{{contextMenu.visible}}" onclick="closeContextMenu">
      <div class="context-menu" style="top: {{contextMenu.top}}px; left: {{contextMenu.left}}px;">
        <div class="menu-item" onclick="handlePlayClick">
          <text class="menu-icon">🔊</text>
          <text class="menu-text">播放消息</text>
        </div>
        <div class="menu-item" onclick="handleDeleteClick">
          <text class="menu-icon">🗑️</text>
          <text class="menu-text">删除消息</text>
        </div>
      </div>
    </div>

    <!-- TabBar -->
    <div class="tabbar">
      <div class="tab-item tab-active" onclick="goCompanion">
        <text class="tab-icon">🏠</text>
        <text class="tab-label">陪伴</text>
      </div>
      <div class="tab-item" onclick="goBreakIce">
        <text class="tab-icon">💬</text>
        <text class="tab-label">聊天</text>
      </div>
      <div class="tab-item" onclick="goMemory">
        <text class="tab-icon">📚</text>
        <text class="tab-label">传承</text>
      </div>
      <div class="tab-item" onclick="goProfile">
        <text class="tab-icon">👤</text>
        <text class="tab-label">我的</text>
      </div>
    </div>
  </div>
</template>

<script>
import storage from '@system.storage'
import $utils from '../../helper/utils'
import chatAPI from '../../helper/apis/chat'
import ttsAPI from '../../helper/apis/tts'
import profileAI from '../../helper/apis/profile_ai'
import { safeReplace } from '../../helper/navigate'

const CONV_ID_KEY = 'companion_conv_id'
const CONV_LIST_KEY = 'companion_conv_list'
const CONV_MSG_PREFIX = 'conv_msgs_'
const DOUBLE_CLICK_DELAY = 500

function checkActive(vm) { return vm && vm.isActive === true }
function generateLocalId() { return Date.now() }
function formatDate(ts) { const d = new Date(ts); const y = d.getFullYear(); const m = String(d.getMonth() + 1).padStart(2, '0'); const day = String(d.getDate()).padStart(2, '0'); return `${y}-${m}-${day}` }
function makeTitle(messages) { const firstUser = messages.find(m => m.role === 'user'); if (firstUser) { return firstUser.content.length > 20 ? firstUser.content.substring(0, 20) + '...' : firstUser.content } return '新对话' }

export default {
  private: {
    messageText: '',
    messages: [],
    isThinking: false,
    conversationId: null,
    showSidebar: false,
    conversationList: [],
    isActive: false,
    timers: [],
    contextMenu: { visible: false, top: 0, left: 0, msg: null },
    lastClickTime: 0,
    lastClickIndex: -1,
  },

  onInit() {
    this.$page.setTitleBar({ text: '' })
    this.isActive = true
    this.restoreConvList()
    this.restoreCurrentConv()
    this.syncFromBackend()
  },

  onShow() { this.isActive = true },
  onHide() {
    this.isActive = false
    this.triggerProfileUpdate()
  },
  onDestroy() {
    this.isActive = false
    this.clearTimers()
  },

  clearTimers() {
    if (Array.isArray(this.timers)) {
      this.timers.forEach(t => { if (t) clearTimeout(t) })
    }
    this.timers = []
  },

  // ========== 本地存储：会话列表 ==========
  restoreConvList() {
    storage.get({
      key: CONV_LIST_KEY,
      success: (data) => {
        if (!checkActive(this)) return
        if (data) {
          try { const list = JSON.parse(data); if (Array.isArray(list)) this.conversationList = list } catch (e) {}
        }
      },
      fail: () => {}
    })
  },
  saveConvList() {
    storage.set({ key: CONV_LIST_KEY, value: JSON.stringify(this.conversationList), success: () => {}, fail: () => {} })
  },
  upsertConvInList(convId, title, createdAt) {
    const existing = this.conversationList.find(c => c.id === convId)
    if (existing) { existing.title = title || existing.title }
    else { this.conversationList.unshift({ id: convId, title: title || '新对话', createdAt: createdAt || formatDate(Date.now()) }) }
    this.saveConvList()
  },

  // ========== 本地存储：会话消息 ==========
  msgKey(convId) { return CONV_MSG_PREFIX + convId },
  loadConvMessages(convId, callback) {
    storage.get({
      key: this.msgKey(convId),
      success: (data) => {
        if (data) { try { const msgs = JSON.parse(data); if (Array.isArray(msgs)) { callback(msgs); return } } catch (e) {} }
        callback(null)
      },
      fail: () => callback(null)
    })
  },
  cacheCurrentConv() {
    if (!this.conversationId || !this.messages || this.messages.length === 0) return
    storage.set({ key: this.msgKey(this.conversationId), value: JSON.stringify(this.messages), success: () => {}, fail: () => {} })
  },
  deleteConvMessages(convId) { storage.delete({ key: this.msgKey(convId), success: () => {}, fail: () => {} }) },

  restoreCurrentConv() {
    storage.get({
      key: CONV_ID_KEY,
      success: (data) => {
        if (!checkActive(this)) return
        let savedId = null
        if (data) { try { const parsed = JSON.parse(data); if (typeof parsed === 'number' && parsed > 0) savedId = parsed } catch (e) {} }
        if (savedId) {
          this.conversationId = savedId
          this.loadConvMessages(savedId, (msgs) => {
            if (!checkActive(this)) return
            if (msgs && msgs.length > 0) { this.messages = msgs }
            else { this.messages = [this.welcomeMsg()] }
            this.scrollToBottom()
          })
        } else {
          this.createNewConversation(false)
        }
      },
      fail: () => { if (checkActive(this)) { this.createNewConversation(false) } }
    })
  },
  saveCurrentConvId(id) {
    storage.set({ key: CONV_ID_KEY, value: JSON.stringify(id), success: () => {}, fail: () => {} })
  },
  welcomeMsg() { return { role: 'assistant', content: '今天过得开心吗？戳戳我，或者直接跟我说说话吧！' } },

  syncFromBackend() {
    chatAPI.listConversations().then(raw => {
      if (!checkActive(this)) return
      let data = raw
      if (raw && typeof raw === 'object' && raw.headers && typeof raw.data === 'string') { try { data = JSON.parse(raw.data) } catch (e) {} }
      if (data && Array.isArray(data.conversations)) {
        data.conversations.forEach(c => {
          const local = this.conversationList.find(l => l.id === c.id)
          if (local) { local.title = c.title || local.title }
        })
        this.saveConvList()
      }
    }).catch(() => {})
  },

  // ========== 侧边栏 ==========
  toggleSidebar() { this.showSidebar = !this.showSidebar },
  closeSidebar() { this.showSidebar = false },
  newConversation() { this.cacheCurrentConv(); this.createNewConversation(true) },
  createNewConversation(closeSidebar) {
    const newId = generateLocalId()
    this.conversationId = newId
    this.saveCurrentConvId(newId)
    this.messages = [this.welcomeMsg()]
    this.upsertConvInList(newId, '新对话', formatDate(Date.now()))
    this.cacheCurrentConv()
    if (closeSidebar) this.showSidebar = false
    this.scrollToBottom()
  },
  switchConversation(targetId) {
    if (targetId === this.conversationId) { this.showSidebar = false; return }
    this.cacheCurrentConv()
    this.conversationId = targetId
    this.saveCurrentConvId(targetId)
    this.showSidebar = false
    this.loadConvMessages(targetId, (msgs) => {
      if (!checkActive(this)) return
      if (msgs && msgs.length > 0) { this.messages = msgs }
      else { this.messages = [this.welcomeMsg()] }
      this.scrollToBottom()
    })
  },
  deleteConversation(convId, event) {
    if (event && event.stopPropagation) event.stopPropagation()
    this.conversationList = this.conversationList.filter(c => c.id !== convId)
    this.saveConvList()
    this.deleteConvMessages(convId)
    chatAPI.deleteConversation(convId).catch(() => {})
    if (this.conversationId === convId) { this.createNewConversation(false) }
    $utils.showToast('已删除')
  },

  // ========== 聊天 ==========
  onMessageChange(event) { this.messageText = event.value || '' },
  sendMessage() {
    if (!checkActive(this)) return
    const content = (this.messageText || '').trim()
    if (!content) { $utils.showToast('请输入内容'); return }
    const tempId = 'temp_' + Date.now()
    this.messages.push({ id: tempId, role: 'user', content: content })
    this.messageText = ''
    const isFirstMessage = !this.messages.some(m => m.role === 'user' && m.id !== tempId)
    this.cacheCurrentConv()
    this.isThinking = true
    this.scrollToBottom()

    chatAPI.sendMessage({
      message: content,
      conversation_id: this.conversationId || null,
    }).then(raw => {
      if (!checkActive(this)) return
      this.isThinking = false
      let data = raw
      if (raw && typeof raw === 'object' && raw.headers && typeof raw.data === 'string') { try { data = JSON.parse(raw.data) } catch (e) {} }
      if (data && data.reply) {
        const userMsg = this.messages.find(m => m.id === tempId)
        if (userMsg && data.message_id) { userMsg.id = data.message_id }
        this.messages.push({ id: data.message_id || Date.now(), role: 'assistant', content: data.reply })
        if (isFirstMessage) { this.upsertConvInList(this.conversationId, makeTitle(this.messages), formatDate(Date.now())) }
        this.cacheCurrentConv()
      } else {
        $utils.showToast('AI 回复为空，请重试')
      }
      this.scrollToBottom()
    }).catch(error => {
      if (!checkActive(this)) return
      this.isThinking = false
      $utils.showToast('AI 回复失败，请重试')
      this.scrollToBottom()
    })
  },
  scrollToBottom() {
    const timer = setTimeout(() => {
      if (!checkActive(this)) return
      try { const el = this.$element('chatList'); if (el && el.scrollTo) el.scrollTo({ index: -1 }) } catch (e) {}
    }, 100)
    this.timers.push(timer)
  },

  // ========== 双击菜单 ==========
  handleMessageClick(index, evt) {
    const now = Date.now()
    if (this.lastClickIndex === index && (now - this.lastClickTime < DOUBLE_CLICK_DELAY)) {
      this.lastClickTime = 0
      this.lastClickIndex = -1
      this.showContextMenu(index, evt)
    } else {
      this.lastClickTime = now
      this.lastClickIndex = index
    }
  },

  showContextMenu(index, evt) {
    const msg = this.messages[index]
    if (!msg) return
    let clientX = 200, clientY = 400
    if (evt && evt.touches && evt.touches.length > 0) {
      clientX = evt.touches[0].clientX
      clientY = evt.touches[0].clientY
    } else if (evt && typeof evt.clientX !== 'undefined') {
      clientX = evt.clientX
      clientY = evt.clientY
    }
    this.contextMenu.visible = true
    this.contextMenu.top = clientY
    this.contextMenu.left = clientX
    this.contextMenu.msg = msg
  },

  closeContextMenu() {
    this.contextMenu.visible = false
    this.contextMenu.msg = null
  },

  handlePlayClick() {
    console.log('handlePlayClick 执行')
    if (this.contextMenu.msg) {
      this.playMessage(this.contextMenu.msg.content)
    }
    this.closeContextMenu()
  },

  handleDeleteClick() {
    console.log('handleDeleteClick 执行')
    if (this.contextMenu.msg) {
      this.deleteMessage(this.contextMenu.msg)
    }
    this.closeContextMenu()
  },

  async playMessage(text) {
    console.log('playMessage 调用, text:', text)
    const voice = (await this.getSelectedVoice()) || 'yunye'
    console.log('使用音色:', voice)
    try {
      await ttsAPI.play(text, voice)
      console.log('播放成功')
    } catch (e) {
      console.error('播放失败:', e)
      $utils.showToast('播放失败')
    }
  },

  getSelectedVoice() {
    return new Promise((resolve) => {
      storage.get({ key: 'selected_voice', success: (data) => resolve(data || ''), fail: () => resolve('') })
    })
  },

  async deleteMessage(msg) {
    const idx = this.messages.indexOf(msg)
    if (idx > -1) this.messages.splice(idx, 1)  // 1. 先从界面移除
    if (msg.id && !String(msg.id).startsWith('temp_')) {
      try { await chatAPI.deleteMessage(msg.id) } catch (e) {}  // 2. 再调用后端删除
    }
    this.cacheCurrentConv()
  },

  // ========== 路由 ==========
  goCompanion() { safeReplace('/pages/Companion') },
  goBreakIce() { safeReplace('/pages/BreakIce') },
  goMemory() { safeReplace('/pages/Memory') },
  goProfile() { safeReplace('/pages/Profile') },

  triggerProfileUpdate() {
    profileAI.updateDynamic()
      .then(res => console.log('[Companion] 动态档案更新完成:', res.messages_used, '条消息'))
      .catch(() => {})
  }
}
</script>


<style lang="less">
/* ================================================================
   莫兰迪色系 (Morandi Palette)
   特点：低饱和度、柔和灰调、不刺眼
   ================================================================ */

// ── 莫兰迪色板 ──
@morandi-bg:        #e8e4df;   // 暖灰底
@morandi-bg-dark:   #dcd5ce;   // 深灰底
@morandi-green:     #b5c4b1;   // 鼠尾草绿（用户气泡）
@morandi-green-dark:#9ab09a;   // 深鼠尾草绿
@morandi-pink:      #d4c5c0;   // 烟粉色（AI 气泡）
@morandi-blue:      #a3b5c7;   // 雾蓝（发送按钮）
@morandi-blue-dark: #8a9eb2;   // 深雾蓝
@morandi-brown:     #c4b7a6;   // 灰棕（用户头像）
@morandi-text:      #5c5c5c;   // 深灰文字
@morandi-text-light:#9a9490;   // 浅灰文字
@morandi-white:     #faf8f5;   // 米白
@morandi-border:    #d9d3cb;   // 暖灰边框
@morandi-tabbar:    #f5f2ee;   // tabbar 背景

.page {
  flex: 1;
  flex-direction: row;
  background-color: @morandi-bg;
  position: relative;
}

/* ========== 侧边栏遮罩 ========== */
.sidebar-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.3);
  z-index: 100;
}

/* ========== 侧边栏 ========== */
.sidebar {
  position: fixed;
  top: 0;
  left: -560px;
  bottom: 0;
  width: 560px;
  background-color: @morandi-white;
  flex-direction: column;
  z-index: 101;
  transition: left 0.25s ease;
}

.sidebar-open {
  left: 0;
}

.sidebar-header {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 40px 30px 20px;
  border-bottom-width: 1px;
  border-bottom-color: @morandi-border;
}

.sidebar-title {
  font-size: 30px;
  font-weight: 600;
  color: @morandi-text;
}

.sidebar-new-btn {
  width: 56px;
  height: 56px;
  border-radius: 28px;
  background-color: @morandi-green;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.sidebar-new-icon {
  font-size: 36px;
  color: @morandi-white;
  font-weight: 300;
}

.sidebar-list {
  flex: 1;
  flex-direction: column;
  overflow-y: auto;
}

.sidebar-item {
  flex-direction: row;
  align-items: center;
  padding: 20px 30px;
  border-bottom-width: 1px;
  border-bottom-color: @morandi-border;
}

.sidebar-item-active {
  background-color: @morandi-bg;
}

.sidebar-item-main {
  flex: 1;
  flex-direction: column;
}

.sidebar-item-title {
  font-size: 26px;
  color: @morandi-text;
  max-lines: 1;
  text-overflow: ellipsis;
}

.sidebar-item-date {
  font-size: 20px;
  color: @morandi-text-light;
  margin-top: 4px;
}

.sidebar-item-del {
  width: 52px;
  height: 52px;
  border-radius: 26px;
  background-color: @morandi-pink;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-left: 12px;
}

.sidebar-del-icon {
  font-size: 28px;
  color: @morandi-text;
  font-weight: 300;
}

.sidebar-empty {
  padding: 60px 30px;
  align-items: center;
}

.sidebar-empty-text {
  font-size: 24px;
  color: @morandi-text-light;
}

/* ========== 主聊天区 ========== */
.main-area {
  flex: 1;
  flex-direction: column;
}

/* ── 顶部标题栏 ── */
.title-bar {
  padding: 30px 30px 16px;
  background-color: @morandi-bg;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.hamburger {
  position: absolute;
  left: 20px;
  top: 34px;
  width: 48px;
  height: 40px;
  flex-direction: column;
  justify-content: space-around;
  padding: 4px 6px;
}

.hamburger-line {
  height: 4px;
  background-color: @morandi-text-light;
  border-radius: 2px;
}

.title-text {
  font-size: 34px;
  font-weight: 600;
  color: @morandi-text;
}

.title-sub {
  font-size: 22px;
  color: @morandi-text-light;
  margin-top: 4px;
}

/* ── 对话列表 ── */
.chat-list {
  flex: 1;
  flex-direction: column;
  padding: 12px 16px;
  padding-bottom: 180px;
}

/* ── 消息行 ── */
.msg-row {
  flex-direction: row;
  margin-bottom: 16px;
}

.msg-ai {
  justify-content: flex-start;
  padding-right: 60px;
}

.msg-user {
  justify-content: flex-end;
  padding-left: 60px;
}

.msg-system {
  justify-content: center;
}

/* ── 头像 ── */
.msg-avatar {
  width: 72px;
  height: 72px;
  border-radius: 8px;
  flex-shrink: 0;
}

.msg-avatar-user {
  background-color: @morandi-brown;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-left: 10px;
}

.avatar-placeholder {
  font-size: 24px;
  color: @morandi-white;
  font-weight: 600;
}

/* ── 消息体 ── */
.msg-body {
  flex-direction: column;
  max-width: 100%;
}

.msg-ai .msg-body {
  margin-left: 10px;
}

.msg-user .msg-body {
  margin-right: 10px;
  align-items: flex-end;
}

/* ── 气泡（莫兰迪色） ── */
.msg-bubble {
  padding: 16px 20px;
  border-radius: 8px;
  max-width: 100%;
}

.msg-bubble-ai {
  background-color: @morandi-pink;
}

.msg-bubble-user {
  background-color: @morandi-green;
}

.msg-bubble-thinking {
  padding: 12px 24px;
}

.msg-text {
  font-size: 28px;
  color: @morandi-text;
  line-height: 36px;
}

.msg-thinking {
  font-size: 32px;
  letter-spacing: 4px;
  color: @morandi-text-light;
}

/* ── 系统消息 ── */
.msg-system-text {
  font-size: 22px;
  color: @morandi-text-light;
  padding: 8px 16px;
  background-color: rgba(0, 0, 0, 0.04);
  border-radius: 6px;
}

