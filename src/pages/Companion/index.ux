  font-size: 32px;
  font-weight: 600;
  color: #a8c5d9;
  margin-top: 10px;
  font-style: italic;
}

.cloudie-hint {
  font-size: 22px;
  color: #a89a8a;
  margin-top: 4px;
}

.bottom-input-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 90px;
  padding: 16px 24px;
  background-color: #fff;
  flex-direction: row;
  align-items: center;
}

.message-input {
  flex: 1;
  height: 72px;
  padding: 0 24px;
  background-color: #f5f0e8;
  border-radius: 36px;
  font-size: 28px;
  color: #4a3728;
  placeholder-color: #b5a899;
}

.send-btn {
  width: 72px;
  height: 72px;
  background-color: #a8c5d9;
