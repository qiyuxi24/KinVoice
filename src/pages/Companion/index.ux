<template>
  <div class="page">
    <div class="header">
      <text class="app-name">Cloudie</text>
      <text class="app-subtitle">你的家庭情绪树洞</text>
    </div>

    <div class="main-content">
      <div class="speech-bubble">
        <text class="speech-text">{{ currentSpeech }}</text>
        <div class="speech-arrow"></div>
      </div>

      <div class="cloudie-container" onclick="onCloudieClick">
        <div class="cloudie-wrapper" :class="{ 'cloudie-bounce': isAnimating }">
          <!-- TODO: 替换为 云朵精灵.png 图片资源 -->
          <image class="cloudie-image" src="../../assets/images/logo.png" mode="aspectFit" />
        </div>
        <text class="cloudie-name">Cloudie</text>
        <text class="cloudie-hint">点击我聊天</text>
      </div>
    </div>

    <div class="bottom-input-area">
      <input class="message-input" type="text" placeholder="告诉小云你的心事吧..." onchange="onMessageChange" />
      <div class="send-btn" onclick="sendMessage">
        <text class="send-icon">→</text>
      </div>
    </div>

    <div class="tabbar">
      <div class="tab-item tab-active" onclick="goCompanion">
        <text class="tab-icon">🏠</text>
        <text class="tab-label">陪伴</text>
      </div>
      <div class="tab-item" onclick="goBreakIce">
        <text class="tab-icon">💬</text>
        <text class="tab-label">破冰</text>
      </div>
      <div class="tab-item" onclick="goMemory">
        <text class="tab-icon">📚</text>
        <text class="tab-label">传承</text>
      </div>
      <div class="tab-item" onclick="goProfile">
        <text class="tab-icon">👤</text>
        <text class="tab-label">我的</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import storage from '@system.storage'
import $utils from '../../helper/utils'
import chatAPI from '../../helper/apis/chat'
import $ajax from '../../helper/ajax'
import config from '../../helper/apis/config'

const HISTORY_KEY = 'companion_chat_history'
const BASE = config.baseUrl

export default {
  private: {
    messageText: '',
    currentSpeech: '今天过得开心吗？戳戳我，或者直接跟我说说话吧！',
    isAnimating: false,
    // 对话历史，用于离开页面时总结
    chatHistory: [],
    replies: [
      '嗨~我是小云，有什么想聊的吗？',
      '今天心情怎么样呀？',
      '我一直在这儿哦，随时可以找我聊天！',
      '有什么烦恼都可以跟我说~',
      '你看起来今天心情不错呢！',
      '抱抱你~',
      '我在认真听呢！',
      '谢谢你愿意跟我分享~',
      '一切都会好起来的！',
      '加油！你很棒的！',
      '嗯嗯，我懂你的感受~',
      '慢慢来，不着急~'
    ],
    thinkingReplies: [
      '让我想想...',
      '嗯...',
      '我懂了~',
      '好的！'
    ]
  },

  onInit() {
    this.$page.setTitleBar({ text: '' })
    this.restoreHistory()
  },

  onShow() {
    // 页面显示时恢复未总结的历史
    this.restoreHistory()
  },

  onHide() {
    // 离开页面时自动总结对话
    this.summarizeAndClear()
  },

  /** 从本地存储恢复对话历史 */
  restoreHistory() {
    storage.get({
      key: HISTORY_KEY,
      success: (data) => {
        if (data) {
          try {
            const saved = JSON.parse(data)
            if (Array.isArray(saved) && saved.length > 0) {
              this.chatHistory = saved
            }
          } catch (e) {
            console.log('恢复对话历史失败:', e)
          }
        }
      },
      fail: () => {}
    })
  },

  /** 持久化对话历史到本地 */
  saveHistory() {
    storage.set({
      key: HISTORY_KEY,
      value: JSON.stringify(this.chatHistory),
      success: () => {},
      fail: (err) => console.log('保存对话历史失败:', err)
    })
  },

  /** 清除本地对话历史 */
  clearHistory() {
    this.chatHistory = []
    storage.delete({
      key: HISTORY_KEY,
      success: () => {},
      fail: () => {}
    })
  },

  /** 离开页面时总结对话 */
  summarizeAndClear() {
    if (this.chatHistory.length < 2) {
      // 至少一轮有效对话才总结
      this.clearHistory()
      return
    }

    $ajax.post(`${BASE}/chat/summarize`, { history: this.chatHistory })
      .then((resp) => {
        console.log('对话总结完成:', resp)
        this.clearHistory()
      })
      .catch((err) => {
        console.log('对话总结失败，保留历史下次重试:', err)
        // 失败不清理，下次 onShow 恢复后继续尝试
      })
  },

  onMessageChange(event) {
    this.messageText = event.value || ''
  },

  onCloudieClick() {
    this.playAnimation()
    const randomIndex = Math.floor(Math.random() * this.replies.length)
    this.currentSpeech = this.replies[randomIndex]
    $utils.showToast('Cloudie在说话~')
  },

  playAnimation() {
    this.isAnimating = true
    setTimeout(() => {
      this.isAnimating = false
    }, 500)
  },

  sendMessage() {
    const content = (this.messageText || '').trim()
    if (!content) {
      $utils.showToast('请输入内容')
      return
    }
    
    this.playAnimation()
    this.currentSpeech = this.thinkingReplies[Math.floor(Math.random() * this.thinkingReplies.length)]
    
    // 记录用户消息
    this.chatHistory.push({ role: 'user', content: content })
    
    this.callCloudieAPI(content)
    this.messageText = ''
  },

  callCloudieAPI(message) {
    chatAPI.sendMessage({
      message: message
    }).then((data) => {
      console.log('API Response:', data)
      if (data && data.reply) {
        this.currentSpeech = data.reply
        // 记录 AI 回复
        this.chatHistory.push({ role: 'assistant', content: data.reply })
        this.saveHistory()
      } else {
        this.currentSpeech = this.getFallbackReply(message)
        this.chatHistory.push({ role: 'assistant', content: this.currentSpeech })
        this.saveHistory()
      }
    }).catch((error) => {
      console.log('API Error:', error)
      this.currentSpeech = this.getFallbackReply(message)
      this.chatHistory.push({ role: 'assistant', content: this.currentSpeech })
      this.saveHistory()
    })
  },

  getFallbackReply(message) {
    if (message.includes('你好') || message.includes('hi') || message.includes('hello')) {
      return '你好呀！我是小云，很高兴认识你~'
    }
    if (message.includes('名字') || message.includes('叫什么')) {
      return '我叫Cloudie，是你的家庭情绪树洞~'
    }
    if (message.includes('烦恼') || message.includes('烦') || message.includes('郁闷')) {
      return '哎呀，怎么了？跟我说说吧，我愿意听你倾诉~'
    }
    if (message.includes('开心') || message.includes('高兴') || message.includes('快乐')) {
      return '太棒了！看到你开心我也很开心呢~'
    }
    if (message.includes('谢谢') || message.includes('感谢')) {
      return '不用谢呀！能帮到你我很开心~'
    }
    if (message.includes('爱') || message.includes('喜欢')) {
      return '爱是很美好的事情呢~ ❤️'
    }
    return this.replies[Math.floor(Math.random() * this.replies.length)]
  },

  goCompanion() {
    router.replace({ uri: '/pages/Companion' })
  },

  goBreakIce() {
    router.replace({ uri: '/pages/BreakIce' })
  },

  goMemory() {
    router.replace({ uri: '/pages/Memory' })
  },

  goProfile() {
    router.replace({ uri: '/pages/Profile' })
  }
}
</script>

