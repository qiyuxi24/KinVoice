<template>
  <div class="page">
    <!-- ========== 侧边栏遮罩 ========== -->
    <div class="sidebar-overlay" if="showSidebar" onclick="closeSidebar"></div>

    <!-- ========== 侧边栏 ========== -->
    <div class="sidebar {{ showSidebar ? 'sidebar-open' : '' }}">
      <!-- 侧边栏头部 -->
      <div class="sidebar-header">
        <text class="sidebar-title">对话记录</text>
        <div class="sidebar-new-btn" onclick="newConversation">
          <text class="sidebar-new-icon">+</text>
        </div>
      </div>

      <!-- 对话列表 -->
      <div class="sidebar-list">
        <block for="conv in conversationList">
          <div class="sidebar-item {{ conv.id === conversationId ? 'sidebar-item-active' : '' }}"
               onclick="switchConversation(conv.id)">
            <div class="sidebar-item-main">
              <text class="sidebar-item-title">{{ conv.title || '新对话' }}</text>
              <text class="sidebar-item-date">{{ conv.created_at }}</text>
            </div>
            <div class="sidebar-item-del" onclick="deleteConversation(conv.id, $event)">
              <text class="sidebar-del-icon">×</text>
            </div>
          </div>
        </block>
        <!-- 空状态 -->
        <div class="sidebar-empty" if="conversationList.length === 0">
          <text class="sidebar-empty-text">暂无对话记录</text>
        </div>
      </div>
    </div>

    <!-- ========== 主聊天区 ========== -->
    <div class="main-area">
      <!-- 顶部标题栏 -->
      <div class="title-bar">
        <div class="hamburger" onclick="toggleSidebar">
          <text class="hamburger-line"></text>
          <text class="hamburger-line"></text>
          <text class="hamburger-line"></text>
        </div>
        <text class="title-text">Cloudie</text>
        <text class="title-sub">你的家庭情绪树洞</text>
      </div>

      <!-- 对话消息列表 -->
      <div class="chat-list" id="chatList">
        <block for="(index, msg) in messages">
          <!-- AI 消息（左对齐） -->
          <div class="msg-row msg-ai" if="msg.role === 'assistant'">
            <image class="msg-avatar" src="../../assets/images/logo.png" />
            <div class="msg-body">
              <div class="msg-bubble msg-bubble-ai">
                <text class="msg-text">{{ msg.content }}</text>
              </div>
            </div>
          </div>
          <!-- 用户消息（右对齐） -->
          <div class="msg-row msg-user" elif="msg.role === 'user'">
            <div class="msg-body">
              <div class="msg-bubble msg-bubble-user">
                <text class="msg-text">{{ msg.content }}</text>
              </div>
            </div>
            <div class="msg-avatar msg-avatar-user">
              <text class="avatar-placeholder">我</text>
            </div>
          </div>
          <!-- 系统提示（居中） -->
          <div class="msg-row msg-system" else>
            <text class="msg-system-text">{{ msg.content }}</text>
          </div>
        </block>

        <!-- 正在输入指示器 -->
        <div class="msg-row msg-ai" if="isThinking">
          <image class="msg-avatar" src="../../assets/images/logo.png" />
          <div class="msg-body">
            <div class="msg-bubble msg-bubble-ai msg-bubble-thinking">
              <text class="msg-text msg-thinking">···</text>
            </div>
          </div>
        </div>

        <!-- 底部占位 -->
        <div class="chat-bottom-spacer"></div>
      </div>

      <!-- 底部输入区 -->
      <div class="bottom-input-area">
        <input class="message-input" type="text" placeholder="告诉小云你的心事吧..." value="{{ messageText }}" onchange="onMessageChange" />
        <div class="send-btn" onclick="sendMessage">
          <text class="send-icon">→</text>
        </div>
      </div>
    </div>

    <!-- TabBar -->
    <div class="tabbar">
      <div class="tab-item tab-active" onclick="goCompanion">
        <text class="tab-icon">🏠</text>
        <text class="tab-label">陪伴</text>
      </div>
      <div class="tab-item" onclick="goBreakIce">
        <text class="tab-icon">💬</text>
        <text class="tab-label">聊天</text>
      </div>
      <div class="tab-item" onclick="goMemory">
        <text class="tab-icon">📚</text>
        <text class="tab-label">传承</text>
      </div>
      <div class="tab-item" onclick="goProfile">
        <text class="tab-icon">👤</text>
        <text class="tab-label">我的</text>
      </div>
    </div>
  </div>
</template>

<script>
import storage from '@system.storage'
import $utils from '../../helper/utils'
import chatAPI from '../../helper/apis/chat'
import profileAI from '../../helper/apis/profile_ai'
import { safeReplace } from '../../helper/navigate'

// 本地存储 key
const CONV_ID_KEY = 'companion_conv_id'       // 当前会话 ID
const CONV_LIST_KEY = 'companion_conv_list'   // 会话列表 [{ id, title, createdAt }]
const CONV_MSG_PREFIX = 'conv_msgs_'          // 会话消息前缀，完整 key = conv_msgs_{id}

/** 获取页面存活标志 */
function checkActive(vm) {
  return vm && vm.isActive === true
}

/** 生成本地会话 ID */
function generateLocalId() {
  return Date.now()
}

/** 格式化日期 */
function formatDate(ts) {
  const d = new Date(ts)
  const y = d.getFullYear()
  const m = String(d.getMonth() + 1).padStart(2, '0')
  const day = String(d.getDate()).padStart(2, '0')
  return `${y}-${m}-${day}`
}

/** 截取会话标题（取第一条用户消息前20字） */
function makeTitle(messages) {
  const firstUser = messages.find(m => m.role === 'user')
  if (firstUser) {
    return firstUser.content.length > 20
      ? firstUser.content.substring(0, 20) + '...'
      : firstUser.content
  }
  return '新对话'
}

export default {
  private: {
    messageText: '',
    // 消息列表：{ role: 'user'|'assistant'|'system', content: string }
    messages: [],
    // 是否正在等待 AI 回复
    isThinking: false,
    // 当前会话 ID（前端本地生成）
    conversationId: null,
    // 侧边栏开关
    showSidebar: false,
    // 会话列表：[{ id, title, createdAt }]
    conversationList: [],
    // 页面存活标志
    isActive: false,
    // 定时器句柄列表
    timers: [],
  },

  onInit() {
    this.$page.setTitleBar({ text: '' })
    this.isActive = true
    // 1. 恢复会话列表
    this.restoreConvList()
    // 2. 恢复当前会话 ID + 消息
    this.restoreCurrentConv()
    // 3. 静默从后端同步（失败不影响）
    this.syncFromBackend()
  },

  onShow() {
    this.isActive = true
  },

  onHide() {
    this.isActive = false
    // 离开页面时静默触发动态档案更新（不阻塞、不弹 toast）
    this.triggerProfileUpdate()
  },

  onDestroy() {
    this.isActive = false
    this.clearTimers()
  },

  clearTimers() {
    if (Array.isArray(this.timers)) {
      this.timers.forEach((timer) => {
        if (timer) clearTimeout(timer)
      })
    }
    this.timers = []
  },

  // ==================== 本地存储：会话列表 ====================

  /** 恢复会话列表 */
  restoreConvList() {
    if (!checkActive(this)) return
    storage.get({
      key: CONV_LIST_KEY,
      success: (data) => {
        if (!checkActive(this)) return
        if (data) {
          try {
            const list = JSON.parse(data)
            if (Array.isArray(list)) {
              this.conversationList = list
            }
          } catch (e) { /* ignore */ }
        }
      },
      fail: () => {}
    })
  },

  /** 持久化会话列表 */
  saveConvList() {
    storage.set({
      key: CONV_LIST_KEY,
      value: JSON.stringify(this.conversationList),
      success: () => {},
      fail: (err) => console.log('[Companion] 保存会话列表失败:', err)
    })
  },

  /** 在会话列表中新增/更新一条记录 */
  upsertConvInList(convId, title, createdAt) {
    const existing = this.conversationList.find(c => c.id === convId)
    if (existing) {
      existing.title = title || existing.title
    } else {
      this.conversationList.unshift({ id: convId, title: title || '新对话', createdAt: createdAt || formatDate(Date.now()) })
    }
    this.saveConvList()
  },

  // ==================== 本地存储：会话消息 ====================

  /** 构建某个会话的消息存储 key */
  msgKey(convId) {
    return CONV_MSG_PREFIX + convId
  },

  /** 从本地存储加载某个会话的消息 */
  loadConvMessages(convId, callback) {
    storage.get({
      key: this.msgKey(convId),
      success: (data) => {
        if (data) {
          try {
            const msgs = JSON.parse(data)
            if (Array.isArray(msgs)) {
              callback(msgs)
              return
            }
          } catch (e) { /* ignore */ }
        }
        callback(null)
      },
      fail: () => callback(null)
    })
  },

  /** 将当前消息列表保存到当前会话的存储中 */
  cacheCurrentConv() {
    if (!this.conversationId) return
    if (!this.messages || this.messages.length === 0) return
    storage.set({
      key: this.msgKey(this.conversationId),
      value: JSON.stringify(this.messages),
      success: () => {},
      fail: (err) => console.log('[Companion] 缓存消息失败:', err)
    })
  },

  /** 删除某个会话的本地消息缓存 */
  deleteConvMessages(convId) {
    storage.delete({
      key: this.msgKey(convId),
      success: () => {},
      fail: () => {}
    })
  },

  // ==================== 当前会话恢复 ====================

  /** 恢复上次的会话 ID，并加载对应消息 */
  restoreCurrentConv() {
    if (!checkActive(this)) return
    storage.get({
      key: CONV_ID_KEY,
      success: (data) => {
        if (!checkActive(this)) return
        let savedId = null
        if (data) {
          try {
            const parsed = JSON.parse(data)
            if (typeof parsed === 'number' && parsed > 0) {
              savedId = parsed
            }
          } catch (e) { /* ignore */ }
        }
        if (savedId) {
          this.conversationId = savedId
          this.loadConvMessages(savedId, (msgs) => {
            if (!checkActive(this)) return
            if (msgs && msgs.length > 0) {
              this.messages = msgs
            } else {
              this.messages = [this.welcomeMsg()]
            }
            this.scrollToBottom()
          })
        } else {
          // 无历史会话，新建一个
          this.createNewConversation(false)
        }
      },
      fail: () => {
        if (checkActive(this)) {
          this.createNewConversation(false)
        }
      }
    })
  },

  /** 持久化当前会话 ID */
  saveCurrentConvId(id) {
    storage.set({
      key: CONV_ID_KEY,
      value: JSON.stringify(id),
      success: () => {},
      fail: (err) => console.log('保存会话 ID 失败:', err)
    })
  },

  /** 欢迎语模板 */
  welcomeMsg() {
    return { role: 'assistant', content: '今天过得开心吗？戳戳我，或者直接跟我说说话吧！' }
  },

  // ==================== 后端静默同步 ====================

  /** 静默从后端同步（失败不影响前端） */
  syncFromBackend() {
    if (!checkActive(this)) return
    chatAPI.listConversations().then((raw) => {
      if (!checkActive(this)) return
      let data = this.unwrapProxy(raw)
      if (data && Array.isArray(data.conversations)) {
        // 合并后端数据到本地列表（以后端为准更新 title）
        data.conversations.forEach(c => {
          const local = this.conversationList.find(l => l.id === c.id)
          if (local) {
            local.title = c.title || local.title
          }
        })
        this.saveConvList()
      }
    }).catch(() => {
      // 静默失败
    })
  },

  // ==================== 代理解包 ====================

  unwrapProxy(raw) {
    let data = raw
    if (raw && typeof raw === 'object' && raw.headers && typeof raw.data === 'string') {
      try {
        data = JSON.parse(raw.data)
      } catch (e) { /* ignore */ }
    }
    return data
  },

  // ==================== 侧边栏 ====================

  toggleSidebar() {
    this.showSidebar = !this.showSidebar
  },

  closeSidebar() {
    this.showSidebar = false
  },

  /** 新建对话（先保存当前会话，再开新的） */
  newConversation() {
    // 先保存当前会话
    this.cacheCurrentConv()
    this.createNewConversation(true)
  },

  /** 内部：创建新会话
   *  @param {boolean} closeSidebar - 是否关闭侧边栏 */
  createNewConversation(closeSidebar) {
    const newId = generateLocalId()
    this.conversationId = newId
    this.saveCurrentConvId(newId)
    this.messages = [this.welcomeMsg()]
    // 注册到会话列表
    this.upsertConvInList(newId, '新对话', formatDate(Date.now()))
    this.cacheCurrentConv()
    if (closeSidebar) {
      this.showSidebar = false
    }
    this.scrollToBottom()
  },

  /** 切换对话：先保存当前会话，再加载目标会话 */
  switchConversation(targetId) {
    if (targetId === this.conversationId) {
      this.showSidebar = false
      return
    }
    // 1. 保存当前会话
    this.cacheCurrentConv()
    // 2. 切换到目标会话
    this.conversationId = targetId
    this.saveCurrentConvId(targetId)
    this.showSidebar = false
    this.loadConvMessages(targetId, (msgs) => {
      if (!checkActive(this)) return
      if (msgs && msgs.length > 0) {
        this.messages = msgs
      } else {
        this.messages = [this.welcomeMsg()]
      }
      this.scrollToBottom()
    })
  },

  /** 删除对话 */
  deleteConversation(convId, event) {
    if (event && event.stopPropagation) {
      event.stopPropagation()
    }
    // 1. 从本地列表移除
    this.conversationList = this.conversationList.filter(c => c.id !== convId)
    this.saveConvList()
    // 2. 删除本地消息缓存
    this.deleteConvMessages(convId)
    // 3. 静默通知后端删除
    chatAPI.deleteConversation(convId).catch(() => {})
    // 4. 如果删除的是当前对话，新建一个
    if (this.conversationId === convId) {
      this.createNewConversation(false)
    }
    $utils.showToast('已删除')
  },

  // ==================== 聊天 ====================

  onMessageChange(event) {
    if (!checkActive(this)) return
    this.messageText = event.value || ''
  },

  sendMessage() {
    if (!checkActive(this)) return
    const content = (this.messageText || '').trim()
    if (!content) {
      $utils.showToast('请输入内容')
      return
    }

    // 首次发送消息：更新会话标题
    const isFirstMessage = !this.messages.some(m => m.role === 'user')
    this.messages.push({ role: 'user', content: content })
    this.messageText = ''

    if (isFirstMessage) {
      this.upsertConvInList(this.conversationId, makeTitle(this.messages), formatDate(Date.now()))
    }
    this.cacheCurrentConv()

    this.isThinking = true
    this.scrollToBottom()

    this.callCloudieAPI(content)
  },

  scrollToBottom() {
    const timer = setTimeout(() => {
      if (!checkActive(this)) return
      try {
        const el = this.$element('chatList')
        if (el && el.scrollTo) {
          el.scrollTo({ index: -1 })
        }
      } catch (e) { /* ignore */ }
    }, 100)
    this.timers.push(timer)
  },

  callCloudieAPI(message) {
    // 后端仍传 conversation_id（如果有的话），后端可据此关联
    chatAPI.sendMessage({
      message: message,
      conversation_id: this.conversationId || null,
    }).then((raw) => {
      if (!checkActive(this)) return
      this.isThinking = false

      let data = this.unwrapProxy(raw)

      if (data && data.reply) {
        this.messages.push({ role: 'assistant', content: data.reply })
        // AI 回复后立即缓存到本地
        this.cacheCurrentConv()
      } else {
        $utils.showToast('AI 回复为空，请重试')
      }
      this.scrollToBottom()
    }).catch((error) => {
      if (!checkActive(this)) return
      console.log('[Companion] API Error:', error)
      this.isThinking = false
      $utils.showToast('AI 回复失败，请重试')
      this.scrollToBottom()
    })
  },

  // ==================== 路由 ====================

  goCompanion() {
    safeReplace('/pages/Companion')
  },

  goBreakIce() {
    safeReplace('/pages/BreakIce')
  },

  goMemory() {
    safeReplace('/pages/Memory')
  },

  goProfile() {
    safeReplace('/pages/Profile')
  },

  // ==================== 档案更新 ====================

  /**
   * 离开 Companion 页面时静默触发动态档案更新。
   * 失败不弹 toast，不影响用户正常使用。
   */
  triggerProfileUpdate() {
    profileAI.updateDynamic('default')
      .then((res) => {
        console.log('[Companion] 动态档案更新完成:', res.messages_used, '条消息')
      })
      .catch((err) => {
        // 静默失败，仅日志记录
        console.log('[Companion] 动态档案更新失败（静默）:', err)
      })
  }
}
</script>

<style lang="less">
/* ================================================================
   莫兰迪色系 (Morandi Palette)
   特点：低饱和度、柔和灰调、不刺眼
   ================================================================ */

// ── 莫兰迪色板 ──
@morandi-bg:        #e8e4df;   // 暖灰底
@morandi-bg-dark:   #dcd5ce;   // 深灰底
@morandi-green:     #b5c4b1;   // 鼠尾草绿（用户气泡）
@morandi-green-dark:#9ab09a;   // 深鼠尾草绿
@morandi-pink:      #d4c5c0;   // 烟粉色（AI 气泡）
@morandi-blue:      #a3b5c7;   // 雾蓝（发送按钮）
@morandi-blue-dark: #8a9eb2;   // 深雾蓝
@morandi-brown:     #c4b7a6;   // 灰棕（用户头像）
@morandi-text:      #5c5c5c;   // 深灰文字
@morandi-text-light:#9a9490;   // 浅灰文字
@morandi-white:     #faf8f5;   // 米白
@morandi-border:    #d9d3cb;   // 暖灰边框
@morandi-tabbar:    #f5f2ee;   // tabbar 背景

.page {
  flex: 1;
  flex-direction: row;
  background-color: @morandi-bg;
  position: relative;
}

/* ========== 侧边栏遮罩 ========== */
.sidebar-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.3);
}

/* ========== 侧边栏 ========== */
.sidebar {
  position: fixed;
  top: 0;
  left: -560px;
  bottom: 0;
  width: 560px;
  background-color: @morandi-white;
  flex-direction: column;
  transition: left 0.25s ease;
}

.sidebar-open {
  left: 0;
}

.sidebar-header {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 40px 30px 20px;
  border-bottom-width: 1px;
  border-bottom-color: @morandi-border;
}

.sidebar-title {
  font-size: 30px;
  font-weight: 600;
  color: @morandi-text;
}

.sidebar-new-btn {
  width: 56px;
  height: 56px;
  border-radius: 28px;
  background-color: @morandi-green;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.sidebar-new-icon {
  font-size: 36px;
  color: @morandi-white;
  font-weight: 300;
}

.sidebar-list {
  flex: 1;
  flex-direction: column;
}

.sidebar-item {
  flex-direction: row;
  align-items: center;
  padding: 20px 30px;
  border-bottom-width: 1px;
  border-bottom-color: @morandi-border;
}

.sidebar-item-active {
  background-color: @morandi-bg;
}

.sidebar-item-main {
  flex: 1;
  flex-direction: column;
}

.sidebar-item-title {
  font-size: 26px;
  color: @morandi-text;
  lines: 1;
  text-overflow: ellipsis;
}

.sidebar-item-date {
  font-size: 20px;
  color: @morandi-text-light;
  margin-top: 4px;
}

.sidebar-item-del {
  width: 52px;
  height: 52px;
  border-radius: 26px;
  background-color: @morandi-pink;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-left: 12px;
}

.sidebar-del-icon {
  font-size: 28px;
  color: @morandi-text;
  font-weight: 300;
}

.sidebar-empty {
  padding: 60px 30px;
  align-items: center;
}

.sidebar-empty-text {
  font-size: 24px;
  color: @morandi-text-light;
}

/* ========== 主聊天区 ========== */
.main-area {
  flex: 1;
  flex-direction: column;
}

/* ── 顶部标题栏 ── */
.title-bar {
  padding: 30px 30px 16px;
  background-color: @morandi-bg;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.hamburger {
  position: absolute;
  left: 20px;
  top: 34px;
  width: 48px;
  height: 40px;
  flex-direction: column;
  justify-content: space-around;
  padding: 4px 6px;
}

.hamburger-line {
  height: 4px;
  background-color: @morandi-text-light;
  border-radius: 2px;
}

.title-text {
  font-size: 34px;
  font-weight: 600;
  color: @morandi-text;
}

.title-sub {
  font-size: 22px;
  color: @morandi-text-light;
  margin-top: 4px;
}

/* ── 对话列表 ── */
.chat-list {
  flex: 1;
  flex-direction: column;
  padding: 12px 16px;
  padding-bottom: 180px;
}

/* ── 消息行 ── */
.msg-row {
  flex-direction: row;
  margin-bottom: 16px;
}

.msg-ai {
  justify-content: flex-start;
  padding-right: 60px;
}

.msg-user {
  justify-content: flex-end;
  padding-left: 60px;
}

.msg-system {
  justify-content: center;
}

/* ── 头像 ── */
