  font-size: 30px;
  font-weight: 600;
  color: #4a3728;
}

.input-textarea {
  width: 100%;
  min-height: 180px;
  padding: 20px;
  background-color: #fff5f5;
  border-radius: 16px;
  font-size: 28px;
  color: #4a3728;
  placeholder-color: #c9b8ad;
  line-height: 34px;
}

.convert-btn {
  width: 100%;
  height: 96px;
  margin-top: 32px;
  background-color: #b5c6d3;
  border-radius: 48px;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  opacity: 0.5;
}

.btn-active {
  background-color: #a8c5d9;
  opacity: 1;
}

.btn-icon {
  font-size: 36px;
  margin-right: 12px;
}

.btn-text {
  font-size: 32px;
  color: #fff;
  font-weight: 500;
}

.result-card {
  width: 100%;
  background-color: #fff;
  border-radius: 20px;
  padding: 24px;
  margin-top: 24px;
  border-left: 6px solid #6bcb77;
}

.result-header {
  margin-bottom: 12px;
}

.result-title {
  font-size: 28px;
  font-weight: 600;
  color: #4a3728;
}

.result-content {
  font-size: 28px;
  color: #5a4a3a;
  line-height: 34px;
}

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 90px;
  background-color: #fff;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
}

.tab-item {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8px 20px;
}

.tab-icon {
  font-size: 36px;
}

.tab-label {
  font-size: 22px;
  color: #9a8b7a;
  margin-top: 4px;
}

.tab-active .tab-label {
  color: #d4874b;
}
</style>