  bottom: 0;
  height: 90px;
  background-color: #fff;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
}

.tab-item {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8px 20px;
}

.tab-icon {
