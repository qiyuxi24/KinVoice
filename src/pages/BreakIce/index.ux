  font-size: 56px;
  margin-bottom: 12px;
}

.empty-text {
  font-size: 28px;
  color: #4a3728;
  font-weight: 500;
  margin-bottom: 6px;
}

.empty-sub {
  font-size: 24px;
  color: #9a8b7a;
  margin-bottom: 20px;
}

.go-family-btn {
  background-color: #d4874b;
  border-radius: 10px;
  padding: 14px 32px;
}

.go-family-text {
  font-size: 26px;
  color: #ffffff;
}

/* 聊天列表项 */
.chat-item {
  flex-direction: row;
  align-items: center;
  background-color: #ffffff;
  border-radius: 16px;
  padding: 20px;
  margin-bottom: 10px;
}

.chat-avatar {
  width: 64px;
  height: 64px;
  border-radius: 32px;
