  flex: 1;
  flex-direction: column;
  background-color: #f7f0e7;
  padding-bottom: 180px;
}

.header {
  padding: 60px 30px 30px;
  flex-direction: column;
  background: linear-gradient(180deg, #fffbf7 0%, #f7f0e7 100%);
}

