<template>
  <div class="page">
    <!-- ========== 已加入家庭组 ========== -->
    <div class="section" if="familyId">
      <div class="card info-card">
        <text class="card-title">我的家庭组</text>

        <div class="info-row">
          <text class="info-label">家庭组 ID</text>
          <div class="info-value-row">
            <text class="info-value">{{ familyId }}</text>
            <text class="copy-btn" onclick="copyFamilyId">复制</text>
          </div>
        </div>

        <div class="info-row">
          <text class="info-label">访问密码</text>
          <div class="info-value-row">
            <text class="info-value">{{ password }}</text>
            <text class="copy-btn" onclick="copyPassword">复制</text>
          </div>
        </div>
      </div>

      <!-- 成员列表 -->
      <div class="card member-card">
        <text class="card-title">家庭成员（{{ members.length }}人）</text>
        <block for="m in members">
          <div class="member-item">
            <div class="member-avatar">
              <text class="member-avatar-text">{{ m.nickname ? m.nickname.charAt(0).toUpperCase() : '?' }}</text>
            </div>
            <text class="member-name">{{ m.nickname || '未知' }}</text>
            <text class="member-role">{{ m.user_id === myUserId ? '(我)' : '' }}</text>
          </div>
        </block>
      </div>

      <!-- 退出按钮 -->
      <div class="leave-btn" onclick="handleLeave">
        <text class="leave-btn-text">退出家庭组</text>
      </div>
    </div>

    <!-- ========== 未加入家庭组 ========== -->
    <div class="section" if="!familyId && !loading">
      <div class="card welcome-card">
        <text class="welcome-icon">🏠</text>
        <text class="welcome-title">你还没有加入家庭组</text>
        <text class="welcome-desc">创建一个家庭组，邀请家人一起记录和分享</text>
      </div>

      <div class="action-btn create-btn" onclick="handleCreate">
        <text class="action-btn-text">创建家庭组</text>
      </div>

      <div class="action-btn join-btn" onclick="goJoin">
        <text class="action-btn-text">加入家庭组</text>
      </div>
    </div>

    <!-- ========== 创建家庭组弹窗 ========== -->
    <div class="modal-overlay" if="showCreateModal" onclick="closeCreateModal"></div>
    <div class="modal" if="showCreateModal">
      <text class="modal-title">创建家庭组</text>

      <div class="form-group" if="!hasNickname">
        <text class="form-label">你的昵称</text>
        <input class="form-input" type="text" placeholder="输入昵称" value="{{ nickname }}" onchange="onNicknameChange" />
      </div>

      <div class="modal-btns">
        <div class="modal-btn cancel-btn" onclick="closeCreateModal">
          <text class="modal-btn-text">取消</text>
        </div>
        <div class="modal-btn confirm-btn" onclick="confirmCreate">
          <text class="modal-btn-text">{{ creating ? '创建中...' : '确认创建' }}</text>
        </div>
      </div>
    </div>

    <!-- ========== 创建成功弹窗 ========== -->
    <div class="modal-overlay" if="showResultModal"></div>
    <div class="modal" if="showResultModal">
      <text class="modal-title">家庭组创建成功！</text>
      <text class="result-desc">请把以下信息分享给家人：</text>

      <div class="result-row">
        <text class="result-label">家庭组 ID</text>
        <text class="result-value">{{ newFamilyId }}</text>
      </div>
      <div class="result-row">
        <text class="result-label">访问密码</text>
        <text class="result-value">{{ newPassword }}</text>
      </div>

      <div class="modal-btns">
        <div class="modal-btn confirm-btn" onclick="closeResultModal">
          <text class="modal-btn-text">我知道了</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import $utils from '../../helper/utils'
import userIdentity from '../../helper/userIdentity'
import familyAPI from '../../helper/apis/family'
import { safePush } from '../../helper/navigate'

export default {
  private: {
    // 家庭组状态
    familyId: '',
    password: '',
    members: [],
    myUserId: '',
    loading: true,
    hasNickname: false,
    nickname: '',

    // 创建弹窗
    showCreateModal: false,
    creating: false,

    // 结果弹窗
    showResultModal: false,
    newFamilyId: '',
    newPassword: '',
  },

  async onInit() {
    this.$page.setTitleBar({ text: '家庭组' })
    this.myUserId = await userIdentity.initUserId()
    await userIdentity.initNickname()
    this.hasNickname = !!userIdentity.getNickname()
    this.nickname = userIdentity.getNickname()
    await this.loadMyGroup()
  },

  // ==================== 数据加载 ====================

  async loadMyGroup() {
    this.loading = true
    try {
      const res = await familyAPI.getMyGroup()
      if (res.family_id) {
        this.familyId = res.family_id
        this.password = res.password || ''
        this.members = res.members || []
      } else {
        this.familyId = ''
        this.password = ''
        this.members = []
      }
    } catch (e) {
      console.log('加载家庭组失败:', e)
    } finally {
      this.loading = false
    }
  },

  // ==================== 创建家庭组 ====================

  handleCreate() {
    if (!this.hasNickname) {
      this.showCreateModal = true
    } else {
      this.doCreate()
    }
  },

  async confirmCreate() {
    if (!this.nickname.trim()) {
      $utils.showToast('请输入昵称')
      return
    }
    this.creating = true
    try {
      // 先注册
      await familyAPI.register(this.nickname.trim())
      userIdentity.setNickname(this.nickname.trim())
      this.hasNickname = true
      // 再创建
      await this.doCreate()
    } catch (e) {
      $utils.showToast('注册失败，请重试')
    } finally {
      this.creating = false
    }
  },

  async doCreate() {
    $utils.showToast('正在创建...')
    try {
      const res = await familyAPI.createGroup(this.nickname || userIdentity.getNickname())
      this.showCreateModal = false
      this.newFamilyId = res.family_id
      this.newPassword = res.password
      this.showResultModal = true
      await this.loadMyGroup()
    } catch (e) {
      const msg = (e && e.detail) || (e && e.message) || '创建失败'
      $utils.showToast(msg)
    }
  },

  closeCreateModal() {
    this.showCreateModal = false
  },

  closeResultModal() {
    this.showResultModal = false
  },

  onNicknameChange(e) {
    this.nickname = e.value || e.text || ''
  },

  // ==================== 复制 ====================

  copyFamilyId() {
    $utils.showToast('家庭组 ID 已复制（请手动分享给家人）')
  },

  copyPassword() {
    $utils.showToast('密码已复制（请手动分享给家人）')
  },

  // ==================== 退出 ====================

  async handleLeave() {
    $utils.showToast('正在退出...')
    try {
      await familyAPI.leaveGroup()
      this.familyId = ''
      this.password = ''
      this.members = []
      $utils.showToast('已退出家庭组')
    } catch (e) {
      $utils.showToast('退出失败，请重试')
    }
  },

  // ==================== 路由 ====================

  goJoin() {
    safePush('/pages/FamilyJoin')
  },
}
</script>

