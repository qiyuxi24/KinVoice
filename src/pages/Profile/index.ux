<template>
  <div class="page">
    <div class="header">
      <div class="user-card" onclick="showEditNickname">
        <div class="avatar">
          <text class="avatar-text">{{ avatarChar }}</text>
        </div>
        <div class="user-info">
          <text class="user-name">{{ nickname || 'Cloudie 用户' }}</text>
          <text class="user-desc">点击修改用户名</text>
        </div>
      </div>
    </div>

    <div class="menu-list">
      <div class="menu-item" onclick="goFamily">
        <text class="menu-icon">🏠</text>
        <text class="menu-text">我的家庭组</text>
        <text class="menu-arrow">›</text>
      </div>
      <div class="menu-item" onclick="goProfileDetail">
        <text class="menu-icon">📋</text>
        <text class="menu-text">用户档案</text>
        <text class="menu-arrow">›</text>
      </div>
      <div class="menu-item" onclick="updateStableProfile">
        <text class="menu-icon">🤖</text>
        <text class="menu-text">{{ updatingStable ? 'AI 分析中...' : 'AI 更新固定档案' }}</text>
        <text class="menu-arrow">›</text>
      </div>
      <div class="menu-item" onclick="showSettings">
        <text class="menu-icon">⚙️</text>
        <text class="menu-text">设置</text>
        <text class="menu-arrow">›</text>
      </div>
      <div class="menu-item" onclick="showAbout">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-text">关于我们</text>
        <text class="menu-arrow">›</text>
      </div>
      <div class="menu-item" onclick="showHelp">
        <text class="menu-icon">❓</text>
        <text class="menu-text">帮助与反馈</text>
        <text class="menu-arrow">›</text>
      </div>
    </div>

    <!-- 修改用户名弹窗 -->
    <div class="modal-overlay" if="showNickModal" onclick="closeNickModal"></div>
    <div class="modal" if="showNickModal">
      <text class="modal-title">修改用户名</text>
      <input class="form-input" type="text" placeholder="输入新用户名" value="{{ newNickname }}" onchange="onNickInput" />
      <div class="modal-btns">
        <div class="modal-btn cancel-btn" onclick="closeNickModal">
          <text class="modal-btn-text">取消</text>
        </div>
        <div class="modal-btn confirm-btn" onclick="saveNickname">
          <text class="modal-btn-text">{{ saving ? '保存中...' : '确认' }}</text>
        </div>
      </div>
    </div>

    <div class="tabbar">
      <div class="tab-item" onclick="goCompanion">
        <text class="tab-icon">🏠</text>
        <text class="tab-label">陪伴</text>
      </div>
      <div class="tab-item" onclick="goBreakIce">
        <text class="tab-icon">💬</text>
        <text class="tab-label">聊天</text>
      </div>
      <div class="tab-item" onclick="goMemory">
        <text class="tab-icon">📚</text>
        <text class="tab-label">传承</text>
      </div>
      <div class="tab-item tab-active">
        <text class="tab-icon">👤</text>
        <text class="tab-label">我的</text>
      </div>
    </div>
  </div>
</template>

<script>
import $utils from '../../helper/utils'
import userIdentity from '../../helper/userIdentity'
import familyAPI from '../../helper/apis/family'
import { safePush, safeReplace } from '../../helper/navigate'

export default {
  private: {
    updatingStable: false,
    nickname: '',
    newNickname: '',
    showNickModal: false,
    saving: false,
  },

  computed: {
    avatarChar() {
      return (this.nickname || 'C').charAt(0).toUpperCase()
    }
  },

  async onInit() {
    this.$page.setTitleBar({ text: '' })
    await userIdentity.initUserId()
    await userIdentity.initNickname()
    this.nickname = userIdentity.getNickname()
  },

  onShow() {
    // 每次回来刷新用户名
    this.nickname = userIdentity.getNickname()
  },

  showEditNickname() {
    this.newNickname = this.nickname
    this.showNickModal = true
  },

  closeNickModal() {
    this.showNickModal = false
  },

  onNickInput(e) {
    this.newNickname = e.value || e.text || ''
  },

  async saveNickname() {
    var name = (this.newNickname || '').trim()
    if (!name) {
      $utils.showToast('用户名不能为空')
      return
    }
    if (this.saving) return
    this.saving = true
    try {
      // 同步到后端
      await familyAPI.register(name)
      // 保存本地
      userIdentity.setNickname(name)
      this.nickname = name
      this.showNickModal = false
      $utils.showToast('用户名已更新')
    } catch (e) {
      $utils.showToast('保存失败，请重试')
    } finally {
      this.saving = false
    }
  },

  goProfileDetail() {
    safePush('/pages/ProfileDetail')
  },

  goFamily() {
    safePush('/pages/Family')
  },

  /**
   * 手动触发 AI 更新固定档案。
   * 从全部对话历史中提取性别、生日、家庭成员等不变信息。
   */
  updateStableProfile() {
    if (this.updatingStable) return
    this.updatingStable = true
    $utils.showToast('AI 正在分析你的对话...')

    profileAI.updateStable('default')
      .then((res) => {
        this.updatingStable = false
        if (res.ok) {
          $utils.showToast('固定档案已更新！')
        } else {
          $utils.showToast(res.content_preview || '更新失败，请稍后重试')
        }
      })
      .catch((err) => {
        this.updatingStable = false
        console.log('固定档案更新失败:', err)
        $utils.showToast('更新失败，请检查网络')
      })
  },

  showSettings() {
    $utils.showToast('设置')
  },

  showAbout() {
    safePush('/pages/About')
  },

  showHelp() {
    $utils.showToast('帮助与反馈')
  },

  goCompanion() {
    safeReplace('/pages/Companion')
  },

  goBreakIce() {
    safeReplace('/pages/BreakIce')
  },

  goMemory() {
    safeReplace('/pages/Memory')
  },

  goProfile() {
    safeReplace('/pages/Profile')
  }
}
</script>

