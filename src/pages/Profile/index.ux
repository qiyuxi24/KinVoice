  flex-direction: column;
  margin-left: 24px;
}

.user-name {
  font-size: 36px;
  font-weight: 600;
  color: #4a3728;
}

.user-desc {
  font-size: 26px;
  color: #8ab4c9;
  margin-top: 8px;
}

.menu-list {
  flex-direction: column;
  padding: 24px;
}

.menu-item {
  flex-direction: row;
  align-items: center;
  background-color: #ffffff;
  border-radius: 16px;
  padding: 24px;
  margin-bottom: 12px;
}

.menu-icon {
  font-size: 40px;
}

.menu-text {
  flex: 1;
  font-size: 30px;
  color: #4a3728;
  margin-left: 16px;
}

.menu-arrow {
  font-size: 36px;
  color: #c9b8ad;
}

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 90px;
  background-color: #fffbf7;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
}

.tab-item {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8px 20px;
}

.tab-icon {
  font-size: 36px;
}

.tab-label {
  font-size: 22px;
  color: #9a8b7a;
  margin-top: 4px;
}

.tab-active .tab-label {
  color: #d4874b;
}

/* ========== 登录面板 ========== */
.login-panel {
  flex-direction: column;
  margin: 0 24px 16px;
  padding: 30px 24px;
  background-color: #ffffff;
  border-radius: 16px;
}

.panel-title {
  font-size: 32px;
  font-weight: 600;
  color: #4a3728;
  margin-bottom: 20px;
  text-align: center;
}

.panel-input {
  height: 72px;
  padding: 0 20px;
  margin-bottom: 16px;
  background-color: #f5ebe0;
  border-radius: 10px;
  font-size: 28px;
  color: #4a3728;
  placeholder-color: #c9b8ad;
}

.panel-btn {
  height: 72px;
  background-color: #d4874b;
  border-radius: 10px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 8px;
}

.panel-btn-text {
  font-size: 30px;
  color: #ffffff;
  font-weight: 600;
}

.panel-switch {
  margin-top: 20px;
  align-items: center;
}

.panel-switch-text {
  font-size: 24px;
  color: #8ab4c9;
}

/* ========== 退出按钮 ========== */
.logout-btn {
  padding: 8px 16px;
  border-radius: 8px;
  background-color: #f0e4d8;
}

.logout-text {
  font-size: 22px;
  color: #9a8b7a;
}
</style>