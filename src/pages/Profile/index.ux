  flex-direction: row;
  align-items: center;
}

.avatar {
  width: 100px;
  height: 100px;
  border-radius: 50px;
  background-color: #9cb5c9;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 44px;
  font-weight: 600;
  color: #ffffff;
}

