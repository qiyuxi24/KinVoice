<script>
// ── 通用导入 ─────────────────────────────────────────
import storage from '@system.storage'
import router from '@system.router'
import $utils from '../../helper/utils'
import { safePush } from '../../helper/navigate'
import { TABS } from '../../helper/tabbar'

// ── Companion 导入 ───────────────────────────────────
import chatAPI from '../../helper/apis/chat'
import profileAI from '../../helper/apis/profile_ai'

// ── BreakIce 导入 ───────────────────────────────────
import userIdentity from '../../helper/userIdentity'
import familyAPI from '../../helper/apis/family'
import chatroomAPI from '../../helper/apis/chatroom'

// ── Memory 导入 ──────────────────────────────────────
import $apis from '../../helper/apis'

// ═══════════════════════════════════════════════════════
//  Companion 常量 & 工具函数
// ═══════════════════════════════════════════════════════
const CONV_ID_KEY = 'companion_conv_id'
const BACKEND_CONV_ID_KEY = 'companion_backend_id'
const CONV_LIST_KEY = 'companion_conv_list'
const CONV_MSG_PREFIX = 'conv_msgs_'

function checkActive(vm) {
  return vm && vm.isActive === true
}

function generateLocalId() {
  return Date.now()
}

function formatDate(ts) {
  const d = new Date(ts)
  const y = d.getFullYear()
  const m = String(d.getMonth() + 1).padStart(2, '0')
  const day = String(d.getDate()).padStart(2, '0')
  return `${y}-${m}-${day}`
}

function makeTitle(messages) {
  const firstUser = messages.find(m => m.role === 'user')
  if (firstUser) {
    return firstUser.content.length > 20
      ? firstUser.content.substring(0, 20) + '...'
      : firstUser.content
  }
  return '新对话'
}

// ═══════════════════════════════════════════════════════
//  Memory 常量 & 工具函数
// ═══════════════════════════════════════════════════════
const STORAGE_KEY = 'memory_cards'
const CATEGORIES = ['人生阅历', '家庭菜谱', '成长故事', '相处感悟']
const SYNC_MIN_INTERVAL = 30000
const SYNC_TS_KEY = '__kv_mem_sync_ts'
const hook2global = global.__proto__ || global

const INITIAL_MOCK_CARDS = {
  '人生阅历': [
    { tag: '人生阅历', date: '2023.10.15', title: '关于工作与选择', author: '爸爸', content: '刚工作时别怕吃亏，所有的经历都是财富。当年我第一次去深圳的时候，兜里只有几百块钱。找工作碰壁了无数次，但每一次失败都让我更清楚自己想要什么。', emotion: '感慨', need: '被理解和指引' },
    { tag: '人生阅历', date: '2022.05.12', title: '买房子的学问', author: '爷爷', content: '买房地段永远是第一位的。当年我们单位分房，很多人图大选了郊区，我选了市中心的小破房。事实证明，便利性比面积更重要。', emotion: '笃定', need: '传承生活智慧' },
    { tag: '人生阅历', date: '2024.01.05', title: '面对失败的勇气', author: '妈妈', content: '你考研失利那段时间，总把自己关在房间里。我想告诉你，失败并不可怕，重要的是要有重新站起来的勇气。', emotion: '心疼', need: '给予鼓励和支持' }
  ],
  '家庭菜谱': [
    { tag: '家庭菜谱', date: '2024.01.02', title: '祖传红烧肉秘方', author: '妈妈', content: '咱们家的红烧肉，关键在于炒糖色。一定不能用老抽上色！锅里放少许油，放入冰糖小火慢熬，起密集小泡后倒入肉块翻炒。', emotion: '自豪', need: '传承家族味道' },
    { tag: '家庭菜谱', date: '2023.12.20', title: '冬日驱寒羊肉汤', author: '奶奶', content: '羊肉去膻味，不用大料，只需要放几片白萝卜一起煮。煮出来的萝卜捞出扔掉，汤就会变得清甜无比。', emotion: '温暖', need: '关爱家人健康' },
    { tag: '家庭菜谱', date: '2024.03.11', title: '秘制糖醋排骨', author: '爸爸', content: '记住口诀：一酒二酱三糖四醋。料酒一勺，生抽两勺，白糖三勺，陈醋四勺，这样调出来的味道最正宗。', emotion: '得意', need: '记录家庭配方' }
  ],
  '成长故事': [
    { tag: '成长故事', date: '2023.06.15', title: '第一次独自旅行', author: '姐姐', content: '18岁那年，我一个人去了云南。在大理的客栈里，我遇到了很多有趣的人，学会了独立和坚强。那是我人生中最宝贵的经历。', emotion: '怀念', need: '记录成长里程碑' },
    { tag: '成长故事', date: '2022.09.01', title: '学会骑自行车', author: '爸爸', content: '你小时候学骑车，摔了很多次都不哭。这种坚持的精神，爸爸很为你骄傲。记住，遇到困难不要轻易放弃。', emotion: '骄傲', need: '鼓励孩子成长' }
  ],
  '相处感悟': [
    { tag: '相处感悟', date: '2024.02.14', title: '沟通的艺术', author: '妈妈', content: '和家人相处，最重要的是倾听。有时候，不需要急着给出建议，安静地听对方说完，就是最好的陪伴。', emotion: '平静', need: '改善家庭沟通' },
    { tag: '相处感悟', date: '2023.11.20', title: '换位思考', author: '爷爷', content: '年纪大了才明白，每个人都有自己的难处。多站在对方的角度想想，很多矛盾就化解了。', emotion: '通透', need: '减少家庭矛盾' }
  ]
}

function flattenCards(grouped) {
  const list = []
  Object.keys(grouped).forEach(key => {
    grouped[key].forEach(c => list.push(c))
  })
  return list
}

function groupCards(list) {
  const grouped = {}
  CATEGORIES.forEach(cat => { grouped[cat] = [] })
  list.forEach(item => {
    const key = grouped[item.tag] ? item.tag : '人生阅历'
    if (grouped[key]) grouped[key].push(item)
  })
  return grouped
}

function localToBackendCreate(item) {
  return {
    category: item.tag || '人生阅历',
    emotion: item.emotion || '感慨',
    observation: item.title || '',
    feeling: item.content || '',
    need: item.need || '记录与传承',
    request: item.author && item.author !== '我' ? '来自' + item.author : null,
    title: item.title || '',
    content: item.content || '',
    author: item.author || '我',
    tag: item.tag || '人生阅历'
  }
}

function localToBackendUpdate(item) {
  return {
    category: item.tag,
    emotion: item.emotion,
    observation: item.title,
    feeling: item.content,
    need: item.need,
    request: item.author && item.author !== '我' ? '来自' + item.author : null
  }
}

export default {
  private: {
    // ── 共享状态 ─────────────────────────────────
    isActive: false,
    activeTab: 'companion',
    tabs: TABS,

    // ── Companion ─────────────────────────────────
    cp_messageText: '',
    cp_messages: [],
    cp_isThinking: false,
    cp_conversationId: null,
    cp_backendConversationId: null,
    cp_showSidebar: false,
    cp_conversationList: [],
    cp_timers: [],

    // ── BreakIce ──────────────────────────────────
    bi_subTab: 'private',
    bi_familyId: '',
    bi_members: [],
    bi_myUserId: '',
    bi_loading: true,
    bi_privatePreviews: {},
    bi_groupPreview: '',

    // ── Memory ────────────────────────────────────
    mm_activeCategory: '人生阅历',
    mm_showModalFlag: false,
    mm_editMode: false,
    mm_editingCard: null,
    mm_editingCardIndex: -1,
    mm_formData: { category: '人生阅历', title: '', content: '', emotion: '感慨', need: '记录与传承', author: '我' },
    mm_cards: { '人生阅历': [], '家庭菜谱': [], '成长故事': [], '相处感悟': [] },
    mm_syncing: false,
    mm_loadingLocal: false,
    mm_timers: [],

    // ── Profile ───────────────────────────────────
    pf_updatingStable: false,
  },

  computed: {
    mm_currentCards() {
      return this.mm_cards[this.mm_activeCategory] || []
    }
  },

  // ═══════════════════════════════════════════════════
  //  生命周期
  // ═══════════════════════════════════════════════════

  onInit() {
    this.$page.setTitleBar({ text: '' })
    this.isActive = true
    // 初始化默认 Tab（陪伴）
    this.cp_restoreConvList()
    this.cp_restoreCurrentConv()
    this.cp_syncFromBackend()
  },

  onShow() {
    this.isActive = true
    // 刷新当前 tab 相关数据
    if (this.activeTab === 'breakIce') {
      this.bi_loadFamilyData()
    }
    if (this.activeTab === 'memory') {
      this.mm_loadFromLocal()
    }
  },

  onHide() {
    this.isActive = false
    // 离开时缓存 Companion 消息 + 触发档案更新
    this.cp_cacheCurrentConv()
    this.cp_triggerProfileUpdate()
  },

  onDestroy() {
    this.isActive = false
    this.cp_clearTimers()
    this.mm_clearTimers()
  },

  // ═══════════════════════════════════════════════════
  //  Tabbar 切换逻辑（核心重构）
  // ═══════════════════════════════════════════════════

  onTabChange(key) {
    if (key === this.activeTab) return
    this.activeTab = key

    // 懒初始化：首次切换到某个 tab 时初始化
    if (key === 'breakIce' && !this._biInited) {
      this._biInited = true
      this.bi_init()
    }
    if (key === 'memory' && !this._mmInited) {
      this._mmInited = true
      this.mm_loadFromLocal()
    }
  },

  // ═══════════════════════════════════════════════════
  //  Section: Companion（陪伴）
  // ═══════════════════════════════════════════════════

  cp_clearTimers() {
    if (Array.isArray(this.cp_timers)) {
      this.cp_timers.forEach(t => { if (t) clearTimeout(t) })
    }
    this.cp_timers = []
  },

  cp_restoreConvList() {
    if (!checkActive(this)) return
    storage.get({
      key: CONV_LIST_KEY,
      success: (data) => {
        if (!checkActive(this)) return
        if (data) {
          try {
            const list = JSON.parse(data)
            if (Array.isArray(list)) this.cp_conversationList = list
          } catch (e) { /* ignore */ }
        }
      },
      fail: () => {}
    })
  },

  cp_saveConvList() {
    storage.set({
      key: CONV_LIST_KEY,
      value: JSON.stringify(this.cp_conversationList),
      success: () => {},
      fail: (err) => console.log('[Main] 保存会话列表失败:', err)
    })
  },

  cp_upsertConvInList(convId, title, createdAt) {
    const existing = this.cp_conversationList.find(c => c.id === convId)
    if (existing) {
      existing.title = title || existing.title
    } else {
      this.cp_conversationList.unshift({ id: convId, title: title || '新对话', createdAt: createdAt || formatDate(Date.now()) })
    }
    this.cp_saveConvList()
  },

  cp_msgKey(convId) {
    return CONV_MSG_PREFIX + convId
  },

  cp_loadConvMessages(convId, callback) {
    storage.get({
      key: this.cp_msgKey(convId),
      success: (data) => {
        if (data) {
          try {
            const msgs = JSON.parse(data)
            if (Array.isArray(msgs)) { callback(msgs); return }
          } catch (e) { /* ignore */ }
        }
        callback(null)
      },
      fail: () => callback(null)
    })
  },

  cp_cacheCurrentConv() {
    if (!this.cp_conversationId) return
    if (!this.cp_messages || this.cp_messages.length === 0) return
    storage.set({
      key: this.cp_msgKey(this.cp_conversationId),
      value: JSON.stringify(this.cp_messages),
      success: () => {},
      fail: (err) => console.log('[Main] 缓存消息失败:', err)
    })
  },

  cp_deleteConvMessages(convId) {
    storage.delete({ key: this.cp_msgKey(convId), success: () => {}, fail: () => {} })
  },

  cp_restoreCurrentConv() {
    if (!checkActive(this)) return
    storage.get({
      key: CONV_ID_KEY,
      success: (data) => {
        if (!checkActive(this)) return
        let savedId = null
        if (data) {
          try {
            const parsed = JSON.parse(data)
            if (typeof parsed === 'number' && parsed > 0) savedId = parsed
          } catch (e) { /* ignore */ }
        }
        if (savedId) {
          this.cp_conversationId = savedId
          this.cp_restoreBackendConvId()
          this.cp_loadConvMessages(savedId, (msgs) => {
            if (!checkActive(this)) return
            if (msgs && msgs.length > 0) {
              this.cp_messages = msgs
            } else {
              this.cp_messages = [this.cp_welcomeMsg()]
            }
            this.cp_scrollToBottom()
          })
        } else {
          this.cp_createNewConversation(false)
        }
      },
      fail: () => {
        if (checkActive(this)) this.cp_createNewConversation(false)
      }
    })
  },

  cp_restoreBackendConvId() {
    storage.get({
      key: BACKEND_CONV_ID_KEY,
      success: (data) => {
        if (!checkActive(this)) return
        if (data) {
          try {
            const parsed = JSON.parse(data)
            if (typeof parsed === 'number' && parsed > 0) this.cp_backendConversationId = parsed
          } catch (e) { /* ignore */ }
        }
      },
      fail: () => {}
    })
  },

  cp_saveCurrentConvId(id) {
    storage.set({ key: CONV_ID_KEY, value: JSON.stringify(id), success: () => {}, fail: (err) => console.log('保存会话 ID 失败:', err) })
  },

  cp_saveBackendConvId(id) {
    storage.set({ key: BACKEND_CONV_ID_KEY, value: JSON.stringify(id), success: () => {}, fail: () => {} })
  },

  cp_welcomeMsg() {
    return { role: 'assistant', content: '今天过得开心吗？戳戳我，或者直接跟我说说话吧！' }
  },

  cp_syncFromBackend() {
    if (!checkActive(this)) return
    chatAPI.listConversations().then((raw) => {
      if (!checkActive(this)) return
      let data = raw
      if (raw && typeof raw === 'object' && raw.headers && typeof raw.data === 'string') {
        try { data = JSON.parse(raw.data) } catch (e) { /* ignore */ }
      }
      if (data && Array.isArray(data.conversations)) {
        data.conversations.forEach(c => {
          const local = this.cp_conversationList.find(l => l.id === c.id)
          if (local) local.title = c.title || local.title
        })
        this.cp_saveConvList()
      }
    }).catch(() => {})
  },

  cp_toggleSidebar() { this.cp_showSidebar = !this.cp_showSidebar },
  cp_closeSidebar() { this.cp_showSidebar = false },

  cp_newConversation() {
    this.cp_cacheCurrentConv()
    this.cp_createNewConversation(true)
  },

  cp_createNewConversation(closeSidebar) {
    const newId = generateLocalId()
    this.cp_conversationId = newId
    this.cp_backendConversationId = null
    this.cp_saveCurrentConvId(newId)
    this.cp_messages = [this.cp_welcomeMsg()]
    this.cp_upsertConvInList(newId, '新对话', formatDate(Date.now()))
    this.cp_cacheCurrentConv()
    if (closeSidebar) this.cp_showSidebar = false
    this.cp_scrollToBottom()
  },

  cp_switchConversation(targetId) {
    if (targetId === this.cp_conversationId) { this.cp_showSidebar = false; return }
    this.cp_cacheCurrentConv()
    this.cp_conversationId = targetId
    this.cp_saveCurrentConvId(targetId)
    this.cp_showSidebar = false
    this.cp_loadConvMessages(targetId, (msgs) => {
      if (!checkActive(this)) return
      if (msgs && msgs.length > 0) this.cp_messages = msgs
      else this.cp_messages = [this.cp_welcomeMsg()]
      this.cp_scrollToBottom()
    })
  },

  cp_deleteConversation(convId, event) {
    if (event && event.stopPropagation) event.stopPropagation()
    this.cp_conversationList = this.cp_conversationList.filter(c => c.id !== convId)
    this.cp_saveConvList()
    this.cp_deleteConvMessages(convId)
    chatAPI.deleteConversation(convId).catch(() => {})
    if (this.cp_conversationId === convId) this.cp_createNewConversation(false)
    $utils.showToast('已删除')
  },

  cp_onMessageChange(event) {
    if (!checkActive(this)) return
    this.cp_messageText = event.value || ''
  },

  cp_sendMessage() {
    if (!checkActive(this)) return
    const content = (this.cp_messageText || '').trim()
    if (!content) { $utils.showToast('请输入内容'); return }

    const isFirstMessage = !this.cp_messages.some(m => m.role === 'user')
    this.cp_messages.push({ role: 'user', content: content })
    this.cp_messageText = ''

    if (isFirstMessage) {
      this.cp_upsertConvInList(this.cp_conversationId, makeTitle(this.cp_messages), formatDate(Date.now()))
    }
    this.cp_cacheCurrentConv()
    this.cp_isThinking = true
    this.cp_scrollToBottom()
    this.cp_callCloudieAPI(content)
  },

  cp_scrollToBottom() {
    const timer = setTimeout(() => {
      if (!checkActive(this)) return
      try {
        const el = this.$element('cpChatList')
        if (el && el.scrollTo) el.scrollTo({ index: -1 })
      } catch (e) { /* ignore */ }
    }, 100)
    this.cp_timers.push(timer)
  },

  cp_callCloudieAPI(message) {
    const backendId = this.cp_backendConversationId || null
    chatAPI.sendMessage({
      message: message,
      conversation_id: backendId,
    }).then((raw) => {
      if (!checkActive(this)) return
      this.cp_isThinking = false
      let data = raw
      if (raw && typeof raw === 'object' && raw.headers && typeof raw.data === 'string') {
        try { data = JSON.parse(raw.data) } catch (e) { /* ignore */ }
      }
      if (data && data.conversation_id) {
        this.cp_backendConversationId = data.conversation_id
        this.cp_saveBackendConvId(data.conversation_id)
      }
      if (data && data.reply) {
        this.cp_messages.push({ role: 'assistant', content: data.reply })
        this.cp_cacheCurrentConv()
      } else {
        $utils.showToast('AI 回复为空，请重试')
      }
      this.cp_scrollToBottom()
    }).catch(() => {
      if (!checkActive(this)) return
      this.cp_isThinking = false
      $utils.showToast('AI 回复失败，请重试')
      this.cp_scrollToBottom()
    })
  },

  cp_triggerProfileUpdate() {
    profileAI.updateDynamic('default')
      .then((res) => console.log('[Main] 动态档案更新完成:', res.messages_used, '条消息'))
      .catch((err) => console.log('[Main] 动态档案更新失败（静默）:', err))
  },

  // ═══════════════════════════════════════════════════
  //  Section: BreakIce（聊天）
  // ═══════════════════════════════════════════════════

  async bi_init() {
    this.bi_myUserId = await userIdentity.initUserId()
    await userIdentity.initNickname()
    await this.bi_loadFamilyData()
  },

  async bi_loadFamilyData() {
    this.bi_loading = true
    try {
      const res = await familyAPI.getMyGroup()
      if (res.family_id) {
        this.bi_familyId = res.family_id
        this.bi_members = (res.members || []).filter(m => m.user_id !== this.bi_myUserId)
      } else {
        this.bi_familyId = ''
        this.bi_members = []
      }
      await this.bi_loadPreviews()
    } catch (e) {
      console.log('加载家庭组数据失败:', e)
    } finally {
      this.bi_loading = false
    }
  },

  async bi_loadPreviews() {
    if (!this.bi_familyId) return
    try {
      const res = await chatroomAPI.getConversations()
      const previews = {}
      let gp = ''
      for (const conv of (res.conversations || [])) {
        if (conv.type === 'private' && conv.peer_user_id) {
          previews[conv.peer_user_id] = conv.last_message || ''
        } else if (conv.type === 'group') {
          gp = conv.last_message || ''
        }
      }
      this.bi_privatePreviews = previews
      this.bi_groupPreview = gp
    } catch (e) {
      console.log('加载聊天预览失败:', e)
    }
  },

  bi_getPrivatePreview(peerId) {
    return this.bi_privatePreviews[peerId] || ''
  },

  bi_switchTab(tab) { this.bi_subTab = tab },

  bi_openPrivateChat(peerId, peerName) {
    safePush(`/pages/ChatRoom?type=private&peer_id=${peerId}&peer_name=${encodeURIComponent(peerName || '')}`)
  },

  bi_openGroupChat() { safePush('/pages/ChatRoom?type=group') },
  bi_goFamily() { safePush('/pages/Family') },

  // ═══════════════════════════════════════════════════
  //  Section: Memory（传承）
  // ═══════════════════════════════════════════════════

  mm_clearTimers() {
    if (Array.isArray(this.mm_timers)) {
      this.mm_timers.forEach(t => { if (t) clearTimeout(t) })
    }
    this.mm_timers = []
  },

  mm_loadFromLocal(callback) {
    if (!checkActive(this)) return
    if (this.mm_loadingLocal) { if (callback) callback(); return }
    this.mm_loadingLocal = true
    storage.get({
      key: STORAGE_KEY,
      success: (data) => {
        if (!checkActive(this)) { this.mm_loadingLocal = false; return }
        let loaded = false
        if (data) {
          try {
            const saved = JSON.parse(data)
            if (saved && typeof saved === 'object' && !Array.isArray(saved)) {
              CATEGORIES.forEach(cat => {
                if (saved[cat] && saved[cat].length > 0) { this.mm_cards[cat] = saved[cat]; loaded = true }
              })
            }
            if (!loaded) this.mm_initWithMockData()
          } catch (e) { console.log('解析本地缓存失败:', e); this.mm_initWithMockData() }
        } else {
          this.mm_initWithMockData()
        }
        this.mm_loadingLocal = false
        if (callback) callback()
      },
      fail: () => {
        if (checkActive(this)) this.mm_initWithMockData()
        this.mm_loadingLocal = false
        if (callback) callback()
      }
    })
  },

  mm_initWithMockData() {
    if (!checkActive(this)) return
    this.mm_cards = JSON.parse(JSON.stringify(INITIAL_MOCK_CARDS))
    this.mm_saveToLocal()
  },

  mm_saveToLocal() {
    storage.set({
      key: STORAGE_KEY,
      value: JSON.stringify(this.mm_cards),
      success: () => {},
      fail: (err) => console.log('保存本地缓存失败:', err)
    })
  },

  mm_syncWithBackend() {
    if (!checkActive(this)) return
    const flatList = flattenCards(this.mm_cards)
    if (flatList.length === 0) return
    if (this.mm_syncing) return
    this.mm_syncing = true
    $apis.cards.sync(flatList)
      .then((resp) => {
        if (!checkActive(this)) return
        if (resp.cards && resp.cards.length > 0) {
          this.mm_cards = groupCards(resp.cards)
          this.mm_saveToLocal()
        }
      })
      .catch((err) => { console.log('同步失败:', err) })
      .finally(() => { if (checkActive(this)) this.mm_syncing = false })
  },

  mm_trySync() {
    if (!checkActive(this)) return
    const now = Date.now()
    const lastSync = hook2global[SYNC_TS_KEY] || 0
    if (now - lastSync < SYNC_MIN_INTERVAL) return
    hook2global[SYNC_TS_KEY] = now
    const timer = setTimeout(() => {
      const idx = this.mm_timers ? this.mm_timers.indexOf(timer) : -1
      if (idx !== -1) this.mm_timers.splice(idx, 1)
      if (checkActive(this)) this.mm_syncWithBackend()
    }, 600)
    if (Array.isArray(this.mm_timers)) this.mm_timers.push(timer)
  },

  mm_switchCategory(cat) { if (checkActive(this)) this.mm_activeCategory = cat },
  mm_selectCategory(cat) { if (checkActive(this)) this.mm_formData.category = cat },

  mm_showModal() {
    if (!checkActive(this)) return
    this.mm_editMode = false
    this.mm_editingCard = null; this.mm_editingCardIndex = -1
    this.mm_formData = { category: '人生阅历', title: '', content: '', emotion: '感慨', need: '记录与传承', author: '我' }
    this.mm_showModalFlag = true
  },

  mm_editCard(card, index) {
    if (!checkActive(this)) return
    this.mm_editMode = true; this.mm_editingCard = card; this.mm_editingCardIndex = index
    this.mm_formData = {
      category: card.tag || '人生阅历', title: card.title || '', content: card.content || '',
      emotion: card.emotion || '感慨', need: card.need || '记录与传承', author: card.author || '我'
    }
    this.mm_showModalFlag = true
  },

  mm_hideModal() {
    if (!checkActive(this)) return
    this.mm_showModalFlag = false; this.mm_editMode = false; this.mm_editingCard = null; this.mm_editingCardIndex = -1
  },

  mm_onTitleChange(event) { if (checkActive(this)) this.mm_formData.title = event.value || '' },
  mm_onContentChange(event) {
    if (!checkActive(this)) return
    this.mm_formData.content = event.text || event.value || (event.detail && event.detail.value) || ''
  },
  mm_onAuthorChange(event) { if (checkActive(this)) this.mm_formData.author = event.value || '我' },

  mm_saveCard() {
    if (!checkActive(this)) return
    if (!this.mm_formData.title || !this.mm_formData.content) { $utils.showToast('请填写完整信息'); return }
    if (this.mm_editMode) this.mm_doUpdateCard()
    else this.mm_doCreateCard()
  },

  mm_doCreateCard() {
    if (!checkActive(this)) return
    const newCard = {
      tag: this.mm_formData.category,
      date: new Date().toLocaleDateString('zh-CN').replace(/\//g, '.'),
      title: this.mm_formData.title, author: this.mm_formData.author || '我',
      content: this.mm_formData.content, emotion: this.mm_formData.emotion || '感慨', need: this.mm_formData.need || '记录与传承'
    }
    $apis.cards.create(localToBackendCreate(newCard)).then((resp) => {
      if (!checkActive(this)) return
      newCard.id = resp.id
      this.mm_cards[this.mm_formData.category].unshift(newCard)
      this.mm_saveToLocal(); this.mm_hideModal(); $utils.showToast('✅ 保存成功')
    }).catch((err) => {
      if (!checkActive(this)) return
      console.log('后端创建失败:', err)
      this.mm_cards[this.mm_formData.category].unshift(newCard)
      this.mm_saveToLocal(); this.mm_hideModal(); $utils.showToast('✅ 已存本地（网络不可用）')
    })
  },

  mm_doUpdateCard() {
    if (!checkActive(this)) return
    const card = this.mm_editingCard; const index = this.mm_editingCardIndex
    if (!card || index < 0) return
    const updated = {
      tag: this.mm_formData.category, title: this.mm_formData.title, content: this.mm_formData.content,
      emotion: this.mm_formData.emotion || '感慨', need: this.mm_formData.need || '记录与传承',
      author: this.mm_formData.author || '我', date: card.date
    }
    const oldTag = card.tag
    const finishUpdate = () => {
      Object.assign(card, updated)
      if (updated.tag !== oldTag) { this.mm_cards[oldTag].splice(index, 1); this.mm_cards[updated.tag].unshift(card) }
      this.mm_saveToLocal(); this.mm_hideModal()
    }
    if (card.id) {
      $apis.cards.update(card.id, localToBackendUpdate(updated)).then(() => {
        if (!checkActive(this)) return
        finishUpdate(); $utils.showToast('✅ 更新成功')
      }).catch((err) => {
        if (!checkActive(this)) return
        console.log('后端更新失败:', err)
        finishUpdate(); $utils.showToast('✅ 已更新本地（网络不可用）')
      })
    } else {
      $apis.cards.create(localToBackendCreate(updated)).then((resp) => {
        if (!checkActive(this)) return
        card.id = resp.id
        finishUpdate(); $utils.showToast('✅ 更新成功')
      }).catch((err) => {
        if (!checkActive(this)) return
        console.log('后端创建失败:', err)
        finishUpdate(); $utils.showToast('✅ 已更新本地（网络不可用）')
      })
    }
  },

  mm_deleteCard(card, index) {
    if (!checkActive(this)) return
    const cat = card.tag || '人生阅历'; const cardId = card.id
    const removeLocal = () => { this.mm_cards[cat].splice(index, 1); this.mm_saveToLocal() }
    if (cardId) {
      $apis.cards.remove(cardId).then(() => { if (checkActive(this)) { removeLocal(); $utils.showToast('🗑️ 已删除') } })
        .catch(() => { if (checkActive(this)) { removeLocal(); $utils.showToast('🗑️ 已删除本地（网络不可用）') } })
    } else {
      removeLocal(); $utils.showToast('🗑️ 已删除')
    }
  },

  // ═══════════════════════════════════════════════════
  //  Section: Profile（我的）
  // ═══════════════════════════════════════════════════

  pf_goProfileDetail() { safePush('/pages/ProfileDetail') },
  pf_goFamily() { safePush('/pages/Family') },

  pf_updateStableProfile() {
    if (this.pf_updatingStable) return
    this.pf_updatingStable = true
    $utils.showToast('AI 正在分析你的对话...')
    profileAI.updateStable('default')
      .then((res) => {
        this.pf_updatingStable = false
        $utils.showToast(res.ok ? '固定档案已更新！' : (res.content_preview || '更新失败，请稍后重试'))
      })
      .catch((err) => {
        this.pf_updatingStable = false
        console.log('固定档案更新失败:', err)
        $utils.showToast('更新失败，请检查网络')
      })
  },

  pf_showSettings() { $utils.showToast('设置') },
  pf_showAbout() { safePush('/pages/About') },
  pf_showHelp() { safePush('/pages/Help') },
}
</script>

